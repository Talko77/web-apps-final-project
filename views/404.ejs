<%# 404 Page Not Found view: Contemporary editorial broadsheet treatment for missing articles and routes. %>
<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/shared/head', { pageTitle: typeof pageTitle !== 'undefined' ? pageTitle : 'Page Not Found — The Daily Web' }) %>
</head>
<body class="public-page error-page surface-canvas flex flex-column height-screen">
  <%- include('partials/public/header-standard', {
    editionLabel: typeof editionLabel !== 'undefined' ? editionLabel : null,
    showBreaking: false,
    searchQuery: ''
  }) %>

  <main class="page-shell width-content pad-inline-5 pad-block-6 flex-grow flex align-center justify-center">
    <section class="surface-paper radius-card shadow-subtle pad-6 text-center width-full" style="max-width: 640px;">
      <span class="text-label text-1 text-uppercase text-bold color-primary">Error 404 · Dispatch Missing</span>
      <h1 class="text-headline text-6 color-body margin-top-2">Page Not Found</h1>
      <p class="text-body text-2 color-muted margin-top-3">
        <%= typeof message !== 'undefined' && message ? message : 'The story, edition, or workspace you were looking for does not exist or has been moved to another desk.' %>
      </p>
      <div class="flex flex-wrap align-center justify-center gap-3 margin-top-5">
        <a class="button button--primary inline-flex align-center gap-2 pad-inline-4 pad-block-3 radius-standard surface-ink color-inverse text-label text-1" href="/">
          <span class="icon text-3" aria-hidden="true">home</span>
          <span>Return to Front Page</span>
        </a>
        <a class="button button--secondary inline-flex align-center gap-2 pad-inline-4 pad-block-3 radius-standard surface-panel color-body text-label text-1" href="/search">
          <span class="icon text-3" aria-hidden="true">search</span>
          <span>Search the Publication</span>
        </a>
        <a class="button button--secondary inline-flex align-center gap-2 pad-inline-4 pad-block-3 radius-standard surface-muted color-muted text-label text-1" href="/staff/login">
          <span class="icon text-3" aria-hidden="true">lock</span>
          <span>Staff Login</span>
        </a>
      </div>
    </section>
  </main>

  <%- include('partials/public/footer') %>
</body>
</html>
