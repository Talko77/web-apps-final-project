<%# Reporter article editor with explicit draft save and review submission actions. %>
<!doctype html>
<html lang="en">
  <head>
    <%- include('../../partials/shared/head', { pageTitle }) %>
  </head>
  <body class="article-editor">
    <%- include('../../partials/newsroom/header', { newsroomRole }) %>
    <main class="article-editor__main newsroom-main">
      <div class="article-editor__workspace reporter-workspace page-shell">
        <nav class="article-editor__breadcrumb" aria-label="Breadcrumb">
          <a class="article-editor__breadcrumb-link" href="/reporter/articles">My Articles</a>
          <span class="article-editor__breadcrumb-separator">/</span>
          <span class="article-editor__breadcrumb-current"><%= article.isNew ? 'New Article' : 'Edit Article' %></span>
        </nav>
        <div class="article-editor__content">
          <% if (article.locked) { %>
          <%# The article is under editorial review and therefore locked for editing %>
          <div
            class="article-editor__notice article-editor__notice--locked"
            role="status"
          >
            <span class="icon icon-filled article-editor__notice-icon">lock</span>
            <div class="article-editor__notice-copy">
              <span class="article-editor__notice-emphasis">Awaiting Editor.</span>
              This article cannot be edited right now. Editing reopens as soon as
              an editor either publishes it or requests changes.
            </div>
          </div>
          <% } %>
          <% if (article.isPublished) { %>
          <%# A published version exists. This update replaces it only once approved %>
          <div
            class="article-editor__notice article-editor__notice--published"
            role="status"
          >
            <span class="icon icon-filled article-editor__notice-icon">info</span>
            <div class="article-editor__notice-copy">
              <span class="article-editor__notice-emphasis">The published version stays live.</span>
              Readers continue to see the published version until an editor
              approves this update.
            </div>
          </div>
          <% } %>
          <% if (article.deskNotes) { %>
          <%# Editor note: the changes requested from the reporter %>
          <div
            class="article-editor__notice article-editor__notice--feedback"
          >
            <span class="icon icon-filled article-editor__notice-icon">rate_review</span>
            <div class="article-editor__notice-copy">
              <h2 class="article-editor__notice-title">Editor Note</h2>
              <p class="article-editor__notice-text"><%= article.deskNotes %></p>
              <p class="article-editor__notice-note">
                Address the note above, then re-submit the article for review.
              </p>
            </div>
          </div>
          <% } %>
          <%# The editing form. Values are saved over Ajax, so there is no submit %>
          <form
            class="article-editor__form"
            id="articleForm"
            data-article-id="<%= article.id %>"
            data-locked="<%= article.locked %>"
          >
            <div class="article-editor__main-column">
              <%# Headline %>
              <div class="article-editor__card article-editor__card--headline">
                <label class="article-editor__label" for="articleTitle">Headline</label>
                <input
                  class="control-input article-editor__input article-editor__input--headline"
                  id="articleTitle"
                  name="articleTitle"
                  maxlength="200"
                  placeholder="Write a clear, concise headline"
                  required
                  type="text"
                  value="<%= article.title %>"
                  <% if (article.locked) { %>disabled<% } %>
                />
                <span class="article-editor__hint">Up to 200 characters. The headline appears in article lists and on the article page.</span>
              </div>
              <%# Summary %>
              <div class="article-editor__card article-editor__card--summary">
                <div class="article-editor__field-header">
                  <label class="article-editor__label" for="articleSubtitle">Summary</label>
                  <p class="article-editor__counter" id="charCounter"></p>
                </div>
                <textarea
                  class="control-input article-editor__input article-editor__input--summary"
                  id="articleSubtitle"
                  name="articleSubtitle"
                  maxlength="500"
                  placeholder="Two lines explaining what the story is about"
                  required
                  rows="3"
                  <% if (article.locked) { %>disabled<% } %>
                ><%= article.subtitle %></textarea>
              </div>
              <%# Lead image %>
              <div class="article-editor__card article-editor__card--image">
                <div class="article-editor__image-field">
                  <label class="article-editor__label" for="articleImageUrl">Lead image URL</label>
                  <input
                    class="control-input article-editor__input article-editor__input--image"
                    id="articleImageUrl"
                    name="articleImageUrl"
                    placeholder="https://..."
                    type="url"
                    value="<%= article.image %>"
                    <% if (article.locked) { %>disabled<% } %>
                  />
                  <span class="article-editor__hint">A 16:9 ratio works best. This field is optional.</span>
                </div>
                <% if (article.image) { %>
                <div class="article-editor__image-preview">
                  <div
                    class="article-editor__preview-media lead-image-preview"
                  >
                    <img
                      class="article-editor__preview-image"
                      alt="<%= article.imageAlt %>"
                      src="<%= article.image %>"
                    />
                  </div>
                  <div class="article-editor__preview-copy lead-image-copy">
                    <span class="article-editor__preview-title">Preview</span>
                    <p class="article-editor__preview-description">
                      This is how the image will look at the top of the article and on cards across the site.
                    </p>
                  </div>
                </div>
                <% } %>
              </div>
              <%# Article body %>
              <div class="article-editor__card article-editor__card--body">
                <div class="article-editor__field-header">
                  <label class="article-editor__label" for="articleBody">Body</label>
                  <span class="article-editor__hint">A blank line between paragraphs splits them on the public page.</span>
                </div>
                <textarea
                  class="article-editor__input article-editor__input--body article-body-input control-input"
                  id="articleBody"
                  name="articleBody"
                  placeholder="Write the article here"
                  required
                  rows="16"
                  <% if (article.locked) { %>disabled<% } %>
                ><%= article.body %></textarea>
              </div>
            </div>
            <%# Sidebar: category and version details %>
            <div class="article-editor__sidebar">
              <div class="article-editor__card article-editor__card--category">
                <div class="article-editor__card-heading">
                  <span class="icon article-editor__card-icon">category</span>
                  <h2 class="article-editor__card-title">Category</h2>
                </div>
                <div class="article-editor__category-field">
                  <label class="article-editor__label" for="articleCategory">Article category</label>
                  <div class="select-control article-editor__select-wrap">
                    <select
                      class="control-input article-editor__input article-editor__input--category"
                      id="articleCategory"
                      name="articleCategory"
                      required
                      <% if (article.locked) { %>disabled<% } %>
                    >
                      <option value="">Select a category</option>
                      <% article.categories.forEach(function (c) { %>
                      <option value="<%= c.value %>" <% if (c.value === article.category) { %>selected<% } %>><%= c.label %></option>
                      <% }) %>
                    </select>
                  </div>
                </div>
              </div>
              <section
                class="article-editor__card article-editor__card--revision"
                aria-labelledby="revisionMetadataTitle"
              >
                <div class="article-editor__card-heading article-editor__card-heading--spaced">
                  <span class="icon article-editor__card-icon">history_edu</span>
                  <h2 class="article-editor__card-title" id="revisionMetadataTitle">
                    Version Details
                  </h2>
                </div>
                <dl class="article-editor__revision-ledger revision-ledger">
                  <div><dt>Author</dt><dd><%= article.author %></dd></div>
                  <div><dt>Status</dt><dd class="article-editor__revision-value--emphasis"><%= article.statusLabel %></dd></div>
                  <div><dt>Live version</dt><dd><%= article.liveVersion %></dd></div>
                  <div><dt>Draft version</dt><dd><%= article.draftVersion %></dd></div>
                  <div><dt>Last saved</dt><dd><%= article.savedAt %></dd></div>
                </dl>
                <p class="article-editor__revision-note revision-note">
                  <span class="icon article-editor__revision-note-icon">policy</span>
                  <span>Submitting moves the article into the editor's review queue. From that point it stays locked until a decision comes back.</span>
                </p>
              </section>
              <section class="article-editor__card article-editor__actions-card" aria-labelledby="articleActionsTitle">
                <div class="article-editor__card-heading">
                  <span class="icon article-editor__card-icon">edit_note</span>
                  <h2 class="article-editor__card-title" id="articleActionsTitle">Article Actions</h2>
                </div>
                <div class="article-editor__actions-status">
                  <span class="article-editor__actions-status-label">Status</span>
                  <span class="status-badge article-editor__status-badge"><%= article.statusLabel %></span>
                </div>
                <div class="article-editor__actions-buttons">
                  <button class="button button--secondary article-editor__save-action" id="saveDraftBtn" type="button" <% if (article.locked) { %>disabled<% } %>>Save Draft</button>
                  <button class="button button--primary article-editor__submit-action" id="submitForReviewBtn" type="button" <% if (article.locked) { %>disabled<% } %>>
                    <span class="icon article-editor__submit-icon">send</span>
                    Submit for Review
                  </button>
                </div>
                <p class="article-editor__action-message state-hidden" id="articleActionMessage" role="status" aria-live="polite"></p>
              </section>
            </div>
          </form>
        </div>
      </div>
    </main>
    <footer class="article-editor__footer newsroom-footer">
      <div class="article-editor__footer-content page-shell">
        The Daily Web — Internal Newsroom System
      </div>
    </footer>
    <script src="/js/article-editor.js" defer></script>
  </body>
</html>
