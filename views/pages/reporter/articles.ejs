<%# Source: my-articles-reporter-portal.html | Mock: data/mock/pages/reporter-articles.json %>
<!doctype html>

<html lang="en">
  <head>
    <%- include('../../partials/shared/head', { pageTitle: pageTitle }) %>
  </head>
  <body
    class="reporter-articles-page surface-page text-body color-body height-screen flex flex-column"
  >
    <%- include('../../partials/newsroom/header', { newsroomRole: newsroomRole }) %>
    <main class="newsroom-main width-full surface-page flex-grow">
      <div class="reporter-workspace page-shell pad-block-3">
        <div
          class="flex align-center gap-2 text-body text-1 color-muted margin-bottom-4"
        >
          <a class="interaction-underline" data-path="articles" href="#"
            >Newsroom CMS</a
          ><span class="color-subtle">/</span
          ><span class="color-body text-semibold">Desk Console</span>
        </div>
        <div class="flex flex-column width-full">
          <!-- Portal Context Sub-Bar -->
          <div
            class="portal-context-bar width-full surface-muted pad-inline-4 pad-block-3 radius-card shadow-subtle margin-bottom-5 flex flex-wrap align-center justify-between gap-3"
          >
            <div class="flex align-center gap-3">
              <span class="text-headline text-4 color-primary"
                >The Daily Web
                <span class="text-normal color-muted"
                  >| Reporter Portal</span
                ></span
              >
              <span
                class="inline-flex align-center pad-inline-3 pad-block-2 radius-standard surface-ink color-inverse text-label text-1 text-uppercase"
                ><%= reporter.desk %></span
              >
            </div>
            <div class="flex align-center gap-4 text-body text-1 color-muted">
              <div class="flex align-center gap-2">
                <div
                  class="avatar-small surface-info color-info text-semibold flex align-center justify-center text-1"
                ><%= reporter.initials %></div>
                <span class="text-medium color-body"
                  ><%= reporter.name %> <span class="color-muted text-normal">(<%= newsroomRole %>)</span></span
                >
              </div>
              <span class="color-subtle">|</span>
              <a
                class="interaction-underline flex align-center gap-1"
                data-path="home"
                href="#"
              >
                <span class="icon text-1">public</span>View
                Public Site
              </a>
              <span class="color-subtle">|</span>
              <a
                class="color-alert interaction-underline flex align-center gap-1"
                data-path="login"
                href="#"
              >
                <span class="icon text-1">logout</span>Log
                Out
              </a>
            </div>
          </div>
          <!-- Page Header & Main Controls -->
          <div
            class="reporter-page-heading flex flex-column md-row align-center justify-between gap-4 margin-bottom-5"
          >
            <div>
              <h1 class="text-headline text-6 color-primary">My Articles</h1>
              <p class="text-body text-1 color-muted margin-top-2">
                Manage your investigative drafts, editorial submissions, and
                published campus reporting.
              </p>
            </div>
            <div class="flex align-center gap-3">
              <button
                class="create-article-button control-button color-inverse text-label text-2 shadow-subtle motion-all"
                type="button"
              >
                <span class="icon text-4">add_circle</span>
                + Create New Article
              </button>
            </div>
          </div>
          <!-- Filter Strip & Search Panel -->
          <div
            class="article-filter-strip surface-paper pad-4 radius-card shadow-subtle margin-bottom-4 flex flex-column md-row align-center justify-between gap-4"
          >
            <!-- Status Filter Pills -->
            <div
              class="flex flex-wrap align-center gap-2"
              id="statusFilterPills"
            >
              <% statusFilters.forEach(function(filter, index) { %>
              <button class="filter-btn <%= index === 0 ? 'active surface-ink color-inverse' : 'surface-panel color-muted' %> pad-inline-3 pad-block-2 radius-standard text-1 text-label motion-colors" aria-pressed="<%= index === 0 %>" data-status="<%= filter.label %>" type="button">
                <%= filter.label %> <span><%= filter.count %></span>
              </button>
              <% }) %>
            </div>
            <!-- Category Dropdown & Keyword Search -->
            <div class="article-filter-controls flex flex-wrap no-wrap align-center gap-3 width-full">
              <div class="category-control relative width-full">
                <select
                  class="control-input width-full surface-muted color-body text-1 text-body radius-standard pad-inline-3 pad-block-2 pad-inline-4 control-pointer"
                  id="categorySelect"
                >
                  <% categories.forEach(function(category) { %>
                  <option value="<%= category %>"><%= category === 'All' ? 'All Categories' : category %></option>
                  <% }) %>
                </select>
                <span
                  class="icon text-4 color-muted absolute"
                  >expand_more</span
                >
              </div>
              <div class="article-search-control relative width-full width-reading">
                <span
                  class="icon text-4 color-muted absolute"
                  >search</span
                >
                <input
                  class="control-input width-full surface-muted color-body text-1 text-body radius-standard pad-inline-4 pad-inline-3 pad-block-2"
                  id="articleSearchInput"
                  placeholder="Search headline or slug..."
                  type="text"
                />
              </div>
            </div>
          </div>
          <!-- Articles Table Container -->
          <div
            class="articles-table-card surface-paper radius-card shadow-subtle overflow-hidden margin-bottom-4"
          >
            <div class="overflow-scroll width-full">
              <table class="reporter-articles-table width-full text-left text-body text-1">
                <thead
                  class="surface-muted text-label text-1 text-uppercase color-muted"
                >
                  <tr>
                    <th
                      class="pad-block-3 pad-inline-4 text-semibold"
                      scope="col"
                    >
                      Article Title
                    </th>
                    <th
                      class="pad-block-3 pad-inline-4 text-semibold"
                      scope="col"
                    >
                      Category
                    </th>
                    <th
                      class="pad-block-3 pad-inline-4 text-semibold"
                      scope="col"
                    >
                      Status
                    </th>
                    <th
                      class="pad-block-3 pad-inline-4 text-semibold"
                      scope="col"
                    >
                      Last Updated
                    </th>
                    <th
                      class="pad-block-3 pad-inline-4 text-semibold text-right"
                      scope="col"
                    >
                      Views
                    </th>
                    <th
                      class="pad-block-3 pad-inline-4 text-semibold text-center"
                      scope="col"
                    >
                      Actions
                    </th>
                  </tr>
                </thead>
                <tbody class="" id="articlesTableBody">
                  <% articles.forEach(function(article) { %>
                  <tr class="article-row motion-colors <%= article.rowClass %>" data-category="<%= article.category %>" data-status="<%= article.status %>">
                    <td class="pad-block-3 pad-inline-4"><div class="flex align-center gap-3">
                      <% if (article.image) { %><img class="avatar-large media-cover radius-standard flex-no-shrink" alt="<%= article.imageAlt %>" data-alt="<%= article.imageAlt %>" src="<%= article.image %>" /><% } else { %><div class="avatar-large radius-standard surface-panel flex align-center justify-center color-muted flex-no-shrink"><span class="icon text-5">image_not_supported</span></div><% } %>
                      <div><a class="text-headline text-4 color-primary interaction-underline truncate block" href="#"><%= article.title %></a><span class="text-1 text-caption <%= article.detailClass %>"><%= article.detail %></span></div>
                    </div></td>
                    <td class="pad-block-3 pad-inline-4"><span class="inline pad-inline-3 pad-block-2 radius-standard surface-panel color-body text-label text-1"><%= article.category %></span></td>
                    <td class="pad-block-3 pad-inline-4"><span class="inline-flex align-center gap-2 pad-inline-3 pad-block-2 radius-standard text-1 text-semibold <%= article.statusClass %>"><span class="radius-pill <%= article.statusClass.split(' ')[0] %>"></span><%= article.status %></span></td>
                    <td class="pad-block-3 pad-inline-4 color-muted"><%= article.updated %></td>
                    <td class="pad-block-3 pad-inline-4 text-right <%= article.views === '-' ? 'color-muted' : 'text-medium color-body' %>"><%= article.views %></td>
                    <td class="pad-block-3 pad-inline-4 text-center"><div class="inline-flex radius-card shadow-subtle" role="group"><button class="pad-inline-3 pad-block-2 text-1 text-label surface-panel color-body radius-standard" type="button">Edit</button><button class="pad-inline-3 pad-block-2 text-1 text-label surface-muted color-muted" type="button">Preview</button><button class="pad-inline-3 pad-block-2 text-1 text-label <%= article.actionClass %> radius-standard" type="button" <%= article.disabled ? 'disabled title="Already live"' : '' %>><%= article.action %></button></div></td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <!-- Empty State (Hidden by default) -->
            <div class="state-hidden pad-6 text-center" id="noResultsState">
              <span
                class="icon text-7 color-subtle state-muted margin-bottom-2"
                >article</span
              >
              <h3 class="text-headline text-4 color-primary">
                No articles found
              </h3>
              <p
                class="text-body text-1 color-muted width-reading margin-top-2"
              >
                Try relaxing your status filter or clearing your search term to
                see other articles.
              </p>
            </div>
          </div>
          <!-- Pagination & Count Bar -->
          <div
            class="articles-pagination flex flex-column sm-row align-center justify-between gap-3 pad-inline-3 pad-block-3"
          >
            <div class="text-body text-1 color-muted">
              Showing
              <span class="text-semibold color-body" id="displayedCount"
                ><%= articles.length %></span
              >
              of <span class="text-semibold color-body"><%= totalArticles %></span> articles
            </div>
            <!-- Bootstrap / Minimal Newsroom Pagination -->
            <div class="inline-flex align-center gap-1">
              <button
                class="pad-inline-3 pad-block-2 radius-standard text-1 text-label surface-paper color-muted interaction-underline motion-colors control-disabled"
                disabled=""
                type="button"
              >
                <span class="icon text-1 align-center"
                  >chevron_left</span
                >
              </button>
              <button
                class="pad-inline-3 pad-block-2 radius-standard text-1 text-label surface-ink color-inverse"
                type="button"
              >
                1
              </button>
              <button
                class="pad-inline-3 pad-block-2 radius-standard text-1 text-label surface-paper color-muted interaction-underline motion-colors"
                type="button"
              >
                2
              </button>
              <button
                class="pad-inline-3 pad-block-2 radius-standard text-1 text-label surface-paper color-muted interaction-underline motion-colors"
                type="button"
              >
                3
              </button>
              <button
                class="pad-inline-3 pad-block-2 radius-standard text-1 text-label surface-paper color-muted interaction-underline motion-colors"
                type="button"
              >
                <span class="icon text-1 align-center"
                  >chevron_right</span
                >
              </button>
            </div>
          </div>
        </div>
        <script>
          (function () {
            let currentStatus = "All";
            let currentCategory = "All";
            let searchQuery = "";

            const filterPills = document.querySelectorAll(
              "#statusFilterPills .filter-btn",
            );
            const categorySelect = document.getElementById("categorySelect");
            const searchInput = document.getElementById("articleSearchInput");
            const rows = document.querySelectorAll(
              "#articlesTableBody .article-row",
            );
            const noResults = document.getElementById("noResultsState");
            const countDisplay = document.getElementById("displayedCount");

            function applyFilters() {
              let visibleCount = 0;
              rows.forEach((row) => {
                const rowStatus = row.getAttribute("data-status");
                const rowCat = row.getAttribute("data-category");
                const textContent = row.textContent.toLowerCase();

                const matchStatus =
                  currentStatus === "All" || rowStatus === currentStatus;
                const matchCategory =
                  currentCategory === "All" || rowCat === currentCategory;
                const matchSearch =
                  !searchQuery || textContent.includes(searchQuery);

                if (matchStatus && matchCategory && matchSearch) {
                  row.classList.remove("state-hidden");
                  visibleCount++;
                } else {
                  row.classList.add("state-hidden");
                }
              });

              if (countDisplay) {
                countDisplay.textContent = visibleCount;
              }

              if (noResults) {
                if (visibleCount === 0) {
                  noResults.classList.remove("state-hidden");
                } else {
                  noResults.classList.add("state-hidden");
                }
              }
            }

            filterPills.forEach((pill) => {
              pill.addEventListener("click", () => {
                filterPills.forEach((p) => {
                  p.classList.remove("active");
                  p.classList.remove("surface-ink", "color-inverse");
                  p.classList.add("surface-panel", "color-muted");
                  p.setAttribute("aria-pressed", "false");
                });
                pill.classList.add("active");
                pill.classList.remove("surface-panel", "color-muted");
                pill.classList.add("surface-ink", "color-inverse");
                pill.setAttribute("aria-pressed", "true");
                currentStatus = pill.getAttribute("data-status");
                applyFilters();
              });
            });

            if (categorySelect) {
              categorySelect.addEventListener("change", (e) => {
                currentCategory = e.target.value;
                applyFilters();
              });
            }

            if (searchInput) {
              searchInput.addEventListener("input", (e) => {
                searchQuery = e.target.value.toLowerCase().trim();
                applyFilters();
              });
            }
          })();
        </script>
      </div>
    </main>
    <footer class="newsroom-footer width-full surface-muted pad-block-3">
      <div class="page-shell text-center text-caption text-1 color-muted">
        The Daily Web Student Newsroom CMS • Internal Editorial Dispatch •
        v1.2.0
      </div>
    </footer>
  </body>
</html>
