<%# The reporter's "My Articles" page. Data comes from pageController.reporterArticles %>
<!doctype html>
<html lang="en">
  <head>
    <%- include('../../partials/shared/head', { pageTitle }) %>
  </head>
  <body class="reporter-articles">
    <%- include('../../partials/newsroom/header', { newsroomRole }) %>
    <main class="reporter-articles__main newsroom-main">
      <div class="reporter-articles__workspace reporter-workspace page-shell">
        <nav class="reporter-articles__breadcrumb" aria-label="Breadcrumb">
          <a class="reporter-articles__breadcrumb-link" href="/reporter/articles">Newsroom</a>
          <span class="reporter-articles__breadcrumb-separator">/</span>
          <span class="reporter-articles__breadcrumb-current">My Articles</span>
        </nav>
        <div class="reporter-articles__content">
          <!-- Context bar: who is signed in and which desk they belong to -->
          <div
            class="reporter-articles__context"
          >
            <div class="reporter-articles__context-title">
              <span class="reporter-articles__context-heading">Reporter Workspace</span>
              <span class="reporter-articles__desk"><%= reporter.desk %></span>
            </div>
            <div class="reporter-articles__reporter">
              <div class="reporter-articles__avatar"><%= reporter.initials %></div>
              <span class="reporter-articles__reporter-name"
                ><%= reporter.name %>
                <span class="reporter-articles__reporter-role">(<%= newsroomRole %>)</span></span
              >
            </div>
          </div>
          <!-- Page heading and the create action -->
          <div
            class="reporter-articles__heading"
          >
            <div>
              <h1 class="reporter-articles__title">My Articles</h1>
              <p class="reporter-articles__description">
                Manage your drafts here, along with the stories waiting on an
                editor and the ones already live on the site.
              </p>
            </div>
            <div class="reporter-articles__heading-actions">
              <a
                class="button button--primary reporter-articles__create-action"
                href="/reporter/articles/new/edit"
              >
                <span class="icon reporter-articles__create-icon">add_circle</span>
                New Article
              </a>
            </div>
          </div>
          <!-- Filter by status, category and free-text search. Filtering runs in the browser -->
          <div
            class="article-filter-strip reporter-articles__filters"
          >
            <div
              class="article-filter-strip__options reporter-articles__filter-options"
              id="statusFilterPills"
              role="group"
              aria-label="Filter by article status"
            >
              <% statusFilters.forEach(function (filter, index) { %>
              <button
                class="article-filter-strip__option filter-btn<%= index === 0 ? ' active' : '' %>"
                data-status="<%= filter.label %>"
                type="button"
              >
                <%= filter.label %> <span>(<%= filter.count %>)</span>
              </button>
              <% }) %>
            </div>
            <div class="reporter-articles__filter-controls">
              <div class="reporter-articles__filter-field reporter-articles__filter-field--category category-control">
                <label class="reporter-articles__filter-label" for="categorySelect">Category</label>
                <select
                  class="control-input reporter-articles__filter-input"
                  id="categorySelect"
                >
                  <% categories.forEach(function (category) { %>
                  <option value="<%= category %>"><%= category %></option>
                  <% }) %>
                </select>
              </div>
              <div class="reporter-articles__filter-field reporter-articles__filter-field--search">
                <label class="reporter-articles__filter-label" for="articleSearchInput">Search by headline</label>
                <input
                  class="control-input reporter-articles__filter-input"
                  id="articleSearchInput"
                  placeholder="Type a word from the headline"
                  type="search"
                />
              </div>
            </div>
          </div>
          <!-- The articles table -->
          <div
            class="reporter-articles__table-card"
          >
            <div class="reporter-articles__table-scroll">
              <table class="reporter-articles__table">
                <thead class="reporter-articles__table-head">
                  <tr>
                    <th scope="col">
                      Headline
                    </th>
                    <th scope="col">
                      Category
                    </th>
                    <th scope="col">
                      Status
                    </th>
                    <th scope="col">
                      Last Updated
                    </th>
                    <th scope="col">
                      Views
                    </th>
                    <th class="reporter-articles__actions-header" scope="col">
                      Actions
                    </th>
                  </tr>
                </thead>
                <tbody id="articlesTableBody">
                  <% articles.forEach(function (a) { %>
                  <tr
                    class="reporter-articles__row article-row"
                    data-status="<%= a.status %>"
                    data-category="<%= a.category %>"
                    data-title="<%= a.title %>"
                  >
                    <td class="reporter-articles__article-cell">
                      <div class="reporter-articles__article">
                        <% if (a.image) { %>
                        <img
                          class="reporter-articles__thumbnail"
                          alt="<%= a.imageAlt %>"
                          src="<%= a.image %>"
                        />
                        <% } else { %>
                        <div
                          class="reporter-articles__thumbnail reporter-articles__thumbnail--placeholder"
                        >
                          <span class="icon reporter-articles__thumbnail-icon">image_not_supported</span>
                        </div>
                        <% } %>
                        <div class="reporter-articles__article-details">
                          <a
                            class="reporter-articles__article-title"
                            href="<%= a.editUrl %>"
                            ><%= a.title %></a
                          >
                          <span class="reporter-articles__article-detail<%= a.status === 'Changes Requested' || a.status === 'Rejected' ? ' reporter-articles__article-detail--alert' : '' %>"
                            ><%= a.detail %></span
                          >
                        </div>
                      </div>
                    </td>
                    <td class="reporter-articles__category-cell">
                      <span class="reporter-articles__category"><%= a.category %></span>
                    </td>
                    <td class="reporter-articles__status-cell">
                      <span
                        class="status-badge reporter-articles__status"
                        ><span class="status-dot reporter-articles__status-dot"></span><%= a.status %></span
                      >
                    </td>
                    <td class="reporter-articles__updated"><%= a.updated %></td>
                    <td
                      class="reporter-articles__views<%= a.views === '-' ? ' reporter-articles__views--empty' : '' %>"
                    ><%= a.views %></td>
                    <td class="reporter-articles__actions-cell">
                      <div class="reporter-articles__actions" role="group">
                        <a
                          class="reporter-articles__action reporter-articles__action--edit"
                          href="<%= a.editUrl %>"
                          >Edit</a
                        ><button
                          class="reporter-articles__action reporter-articles__action--submit"
                          data-submit-id="<%= a.id %>"
                          type="button"
                          <% if (a.disabled) { %>disabled<% } %>
                        ><%= a.action %></button>
                      </div>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <p
              class="reporter-articles__empty state-hidden"
              id="noResultsState"
            >
              No articles match the current filters. Try another status or
              category, or clear the search.
            </p>
          </div>
          <!-- Result counter and system messages -->
          <div
            class="reporter-articles__pagination"
          >
            <div class="reporter-articles__results">
              Showing
              <span class="reporter-articles__results-count" id="displayedCount"
                ><%= articles.length %></span
              >
              of
              <span class="reporter-articles__results-count"><%= totalArticles %></span>
              articles
            </div>
            <p
              class="reporter-articles__status-message state-hidden"
              id="reporterStatus"
              role="status"
              aria-live="polite"
            ></p>
          </div>
        </div>
      </div>
    </main>
    <footer class="reporter-articles__footer newsroom-footer">
      <div class="reporter-articles__footer-content page-shell">
        The Daily Web — Internal Newsroom System
      </div>
    </footer>
    <script src="/js/reporterArticles.js" defer></script>
  </body>
</html>
