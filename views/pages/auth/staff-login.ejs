<%# Newsroom staff login. Authentication happens on the server; staff-login.js only posts the credentials %>
<!doctype html>
<html lang="en">
  <head>
    <%- include('../../partials/shared/head', { pageTitle }) %>
  </head>
  <body class="staff-login-page">
    <main class="staff-login">
      <div class="staff-login__panel">
          <div class="staff-login__header">
            <div class="staff-login__logo">
              <%- include('../../partials/shared/site-logo', {
                logoHref: page.publicWebsiteHref,
                publicationName: page.publicationName
              }) %>
            </div>
          </div>

          <div class="staff-login__intro">
            <h1 class="staff-login__title"><%= page.heading %></h1>
            <p class="staff-login__description"><%= page.intro %></p>
          </div>

          <form
            class="staff-login__form"
            id="loginForm"
            data-next="<%= page.next %>"
          >
            <div class="form-field staff-login__field">
              <label class="form-field__label staff-login__label" for="staffUsername"
                ><%= page.form.usernameLabel %></label
              >
              <input
                class="form-field__control staff-login__control"
                id="staffUsername"
                name="username"
                type="text"
                autocomplete="username"
                placeholder="<%= page.form.usernamePlaceholder %>"
                required
              />
            </div>
            <div class="form-field staff-login__field">
              <label class="form-field__label staff-login__label" for="staffPassword"
                ><%= page.form.passwordLabel %></label
              >
              <input
                class="form-field__control staff-login__control"
                id="staffPassword"
                name="password"
                type="password"
                autocomplete="current-password"
                placeholder="<%= page.form.passwordPlaceholder %>"
                required
              />
            </div>
            <button
              class="button button--primary login-submit"
              type="submit"
            >
              <%= page.form.submitLabel %>
            </button>
            <p
              class="login-feedback staff-login__status state-hidden"
              id="statusMessage"
              role="status"
              aria-live="polite"
            ></p>
          </form>

          <div class="staff-login__return">
            <a class="staff-login__return-link"
              href="<%= page.publicWebsiteHref %>"
            >
              <span aria-hidden="true">←</span>
              <span><%= page.returnLabel %></span>
            </a>
          </div>
      </div>
    </main>
    <script src="/js/staff-login.js" defer></script>
  </body>
</html>
