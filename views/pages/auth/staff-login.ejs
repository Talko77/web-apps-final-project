<%# Source: staff-login.html | Shared partials: shared/head, shared/site-logo %>
<!doctype html>

<html lang="en">
  <head>
    <%- include('../../partials/shared/head', { pageTitle: page.title }) %>
  </head>
  <body
    class="staff-login-page surface-page text-body text-2 color-body height-screen flex align-center justify-center pad-5"
  >
    <main class="login-shell width-full width-reading">
      <div class="flex flex-column width-full">
        <div
          class="login-panel surface-paper radius-panel shadow-raised pad-6 flex flex-column align-center"
        >
          <!-- Masthead / Brand Emblem -->
          <div class="width-full flex flex-column align-center margin-bottom-5">
            <div class="login-logo-wrap width-full flex align-center justify-center">
              <%- include('../../partials/shared/site-logo', {
                logoHref: page.publicWebsiteHref,
                publicationName: page.publicationName
              }) %>
            </div>
            <div class="flex align-center gap-2 margin-top-2">
              <span
                class="login-network-dot radius-pill surface-alert state-loading"
              ></span>
              <span class="text-label text-1 text-uppercase color-muted"><%= page.networkLabel %></span>
            </div>
          </div>

          <!-- Editorial Auth Header -->
          <div class="width-full text-center margin-bottom-5">
            <h1 class="text-headline text-5 color-body"><%= page.heading %></h1>
            <p class="text-body text-1 color-muted margin-top-2"><%= page.intro %></p>
          </div>

          <!-- Academic Evaluation Notice -->
          <div
            class="login-demo-notice width-full surface-info radius-card pad-3 margin-bottom-5"
          >
            <div class="flex align-start gap-2">
              <span class="text-label text-1 color-info text-uppercase"><%= page.demoAccounts.label %></span>
            </div>
            <div class="margin-top-2 text-body text-1 color-info text-relaxed">
              <% page.demoAccounts.accounts.forEach((account) => { %>
                <div>
                  <strong class="text-label text-1 color-info"><%= account.role %>:</strong>
                  <%= account.email %> / <%= account.password %>
                </div>
              <% }) %>
            </div>
          </div>

          <!-- Authentication Form -->
          <form class="width-full flex flex-column gap-4" id="loginForm">
            <div class="flex flex-column gap-1">
              <label class="text-label text-1 color-body" for="staffEmail"><%= page.form.emailLabel %></label>
              <div class="relative">
                <input
                  class="width-full surface-muted color-body text-body text-2 pad-inline-4 pad-block-3 radius-card control-input motion-colors"
                  id="staffEmail"
                  name="email"
                  placeholder="<%= page.form.emailPlaceholder %>"
                  required
                  type="email"
                />
              </div>
            </div>
            <div class="flex flex-column gap-1">
              <div class="flex justify-between align-center">
                <label class="text-label text-1 color-body" for="staffPassword"><%= page.form.passwordLabel %></label>
                <a class="text-body text-1 color-muted motion-colors" href="<%= page.form.forgotPasswordHref %>"><%= page.form.forgotPasswordLabel %></a>
              </div>
              <div class="relative">
                <input
                  class="width-full surface-muted color-body text-body text-2 pad-inline-4 pad-block-3 radius-card control-input motion-colors"
                  id="staffPassword"
                  name="password"
                  placeholder="<%= page.form.passwordPlaceholder %>"
                  required
                  type="password"
                />
              </div>
            </div>
            <div class="flex align-center gap-2 margin-top-2">
              <input
                class="login-remember-checkbox radius-standard control-pointer"
                id="rememberMe"
                name="remember"
                type="checkbox"
              />
              <label
                class="text-body text-1 color-muted control-pointer control-no-select"
                for="rememberMe"
              ><%= page.form.rememberLabel %></label>
            </div>
            <button
              class="login-submit width-full margin-top-2 pad-block-3 pad-inline-4 surface-ink color-inverse text-label text-2 radius-card shadow-subtle motion-all flex align-center justify-center gap-2"
              id="signInBtn"
              type="submit"
            >
              <span><%= page.form.submitLabel %></span>
              <span class="text-body text-1" aria-hidden="true">→</span>
            </button>
            <div
              class="login-feedback state-hidden text-center pad-block-2 pad-inline-3 radius-card text-body text-1 margin-top-2"
              id="statusMessage"
              aria-live="polite"
              role="status"
            ></div>
          </form>

          <!-- Navigation Escape Link -->
          <div class="margin-top-6 margin-top-4 width-full flex justify-center">
            <a
              class="text-body text-1 color-muted motion-colors flex align-center gap-2"
              href="<%= page.publicWebsiteHref %>"
            >
              <span aria-hidden="true">←</span>
              <span><%= page.returnLabel %></span>
            </a>
          </div>
        </div>

        <!-- Terminal Telemetry Footer -->
        <div
          class="login-telemetry margin-top-4 flex justify-between align-center pad-inline-3 color-muted text-caption text-1"
        >
          <span><%= page.telemetry.engine %></span>
          <span class="flex align-center gap-1">
            <span class="login-security-dot radius-pill surface-info state-muted"></span>
            <%= page.telemetry.security %>
          </span>
        </div>
      </div>
    </main>
  </body>
</html>
