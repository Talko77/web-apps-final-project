<%# Public article reading view: renders article header, media, body paragraphs, tags, related articles, comment thread, and weather sidebar.
    Follows BEM component conventions (.article-page, .article-comments). %>
<!doctype html>
<html lang="en">
<head><%- include('../../partials/shared/head', { pageTitle }) %></head>
<body class="public-page article-page">
<%- include('../../partials/public/header-standard', { editionLabel, showBreaking, breakingText, searchQuery: '' }) %>
<main class="article-page__main">
  <div class="article-page__container page-shell">
    <div class="article-page__layout">
      <div class="article-page__primary">
        <article class="article-page__content">
          <nav aria-label="Breadcrumb" class="article-page__breadcrumb">
            <a class="article-page__breadcrumb-link" href="/">Home</a>
            <span class="article-page__breadcrumb-separator icon" aria-hidden="true">chevron_right</span>
            <a class="article-page__breadcrumb-link" href="/category/<%= article.category.toLowerCase() %>"><%= article.category %></a>
          </nav>

          <%# Article header and byline %>
          <header class="article-page__header">
            <div class="article-page__meta-bar">
              <span class="article-page__category"><%= article.category %></span>
              <% if (article.updateCount > 0) { %>
              <span class="article-page__updates">
                <span class="article-page__updates-dot"></span>
                Updated <%= article.updateCount %> times since publication
              </span>
              <% } %>
            </div>
            <h1 class="article-page__title"><%= article.title %></h1>
            <% if (article.summary) { %>
            <p class="article-page__deck"><%= article.summary %></p>
            <% } %>
            <div class="article-page__byline">
              <div class="article-page__author-info">
                <div class="article-page__author-avatar"><%= article.initials %></div>
                <div class="article-page__author-details">
                  <div class="article-page__author-name"><%= article.reporterName %></div>
                  <div class="article-page__pub-meta">
                    <time datetime="<%= article.datetime %>"><%= article.dateLabel %></time> • <%= article.readLabel %>
                  </div>
                </div>
              </div>
              <div class="article-page__metrics">
                <span class="icon" aria-hidden="true">visibility</span>
                <span><%= article.views %> views</span>
              </div>
            </div>
          </header>

          <%# Featured media %>
          <% if (article.imageUrl) { %>
          <figure class="article-page__media">
            <div class="article-page__media-frame">
              <img class="article-page__media-image" src="<%= article.imageUrl %>" alt="<%= article.imageAlt %>">
            </div>
          </figure>
          <% } %>

          <%# Article body copy %>
          <div class="article-page__body">
            <% (article.paragraphs || []).forEach(function (p) { %>
            <p><%= p %></p>
            <% }) %>
          </div>

          <% if ((locals.tags || []).length) { %>
          <div class="article-page__tags">
            <span class="article-page__tags-label">Filed under:</span>
            <% (locals.tags || []).forEach(function (tag) { %>
            <a class="article-tags__link" href="/category/<%= tag.toLowerCase() %>"><%= tag %></a>
            <% }) %>
          </div>
          <% } %>

          <%# Related stories %>
          <% if ((locals.related || []).length) { %>
          <section aria-labelledby="related-heading" class="article-page__related">
            <div class="article-page__related-header">
              <h2 class="article-page__related-title" id="related-heading">More on this story</h2>
            </div>
            <div class="article-page__related-grid">
              <% (locals.related || []).forEach(function (item) { %>
              <%- include('../../partials/public/article-card', { article: item }) %>
              <% }) %>
            </div>
          </section>
          <% } %>

          <%# Comments section and submission form %>
          <section aria-labelledby="comments-title" class="article-comments">
            <div class="article-comments__header">
              <div class="article-comments__title-group">
                <h2 class="article-comments__title" id="comments-title">Comments</h2>
                <span class="article-comments__count" id="comments-count"><%= commentsCount %></span>
              </div>
            </div>

            <form class="article-comments__form" id="comment-form" data-article-id="<%= article.id %>">
              <div class="article-comments__form-header">
                <span class="article-comments__form-title">Add a comment</span>
                <span class="article-comments__form-hint">No sign-up required</span>
              </div>
              <div class="article-comments__field">
                <label class="article-comments__label" for="guest-name">Name (optional)</label>
                <input class="article-comments__input" id="guest-name" name="name" type="text">
              </div>
              <div class="article-comments__field">
                <div class="article-comments__field-header">
                  <label class="article-comments__label" for="comment-text">Your comment</label>
                  <span class="article-comments__counter" id="char-counter"></span>
                </div>
                <textarea class="article-comments__textarea" id="comment-text" name="comment" maxlength="1000" required rows="3"></textarea>
              </div>
              <p class="article-comments__status state-hidden" id="comment-status" role="status"></p>
              <div class="article-comments__form-footer">
                <p class="article-comments__policy">You can post up to three comments per minute.</p>
                <button class="article-comments__submit" type="submit">Post Comment</button>
              </div>
            </form>

            <%# The flag only decides whether the moderation controls are drawn; the API re-checks the role %>
            <div class="article-comments__list" id="comments-list" data-can-moderate="<%= currentUser && currentUser.role === 'Editor' ? 'true' : 'false' %>">
              <% (locals.comments || []).forEach(function (comment) { %>
              <%- include('../../partials/comments/comment-item', { item: comment }) %>
              <% }) %>
            </div>
            <% if (!(locals.comments || []).length) { %>
            <p class="article-comments__empty">No comments yet. Be the first to join the conversation.</p>
            <% } %>
          </section>
        </article>
      </div>

      <%# Weather sidebar %>
      <aside class="article-page__sidebar" aria-label="Sidebar">
        <section class="article-page__weather" aria-label="Weather">
          <div id="weatherWidget"></div>
        </section>
      </aside>
    </div>
  </div>
</main>
<%- include('../../partials/public/footer') %>
<script src="/js/comments.js" defer></script>
<script src="/js/weather.js" defer></script>
</body>
</html>
