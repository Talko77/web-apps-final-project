<%# Public article reading view: renders article header, media, body paragraphs, tags, related articles, comment thread, and weather sidebar. %>
<!doctype html>
<html lang="en">
<head><%- include('../../partials/shared/head', { pageTitle }) %></head>
<body class="public-page article-page surface-page text-body color-body height-screen flex flex-column">
<%- include('../../partials/public/header-standard', { editionLabel, showBreaking, breakingText, searchQuery: '' }) %>
<main class="article-page-main width-full surface-page flex-grow">
  <div class="width-content page-shell pad-inline-5 pad-block-3">
    <div class="search-layout grid grid-single lg-editorial-grid gap-6 align-start">
      <div class="lg-content-span flex flex-column gap-6">
        <article class="article-reading width-full">
          <nav aria-label="Breadcrumb" class="article-breadcrumb flex align-center gap-2 text-label text-1 color-muted margin-bottom-5">
            <a class="motion-colors" href="/">Home</a>
            <span class="icon color-subtle text-1" aria-hidden="true">chevron_right</span>
            <a class="motion-colors" href="/search?category=<%= article.category %>"><%= article.category %></a>
          </nav>

          <%# Article header and byline %>
          <header class="article-heading margin-bottom-6">
            <div class="flex align-center gap-3 margin-bottom-2">
              <span class="surface-raised color-primary text-kicker text-1 pad-block-2 radius-standard text-uppercase text-bold"><%= article.category %></span>
              <% if (article.updateCount > 0) { %>
              <span class="color-muted text-caption text-1 flex align-center gap-1"><span class="radius-pill"></span>Updated <%= article.updateCount %> times since publication</span>
              <% } %>
            </div>
            <h1 class="text-display text-heading-xl color-primary margin-bottom-4 text-tight"><%= article.title %></h1>
            <% if (article.summary) { %>
            <p class="text-deck color-muted text-relaxed margin-bottom-5"><%= article.summary %></p>
            <% } %>
            <div class="article-byline flex flex-wrap align-center justify-between gap-4 pad-block-3 surface-muted pad-inline-4 radius-card">
              <div class="flex align-center gap-3">
                <div class="avatar-medium radius-pill surface-ink color-inverse flex align-center justify-center text-label text-1 shadow-subtle"><%= article.initials %></div>
                <div>
                  <div class="text-label text-2 color-primary"><%= article.reporterName %></div>
                  <div class="text-caption text-1 color-muted">
                    <time datetime="<%= article.datetime %>"><%= article.dateLabel %></time> • <%= article.readLabel %>
                  </div>
                </div>
              </div>
              <div class="flex align-center gap-5 color-muted text-caption text-1">
                <span class="flex align-center gap-1"><span class="icon text-2">visibility</span><%= article.views %> views</span>
              </div>
            </div>
          </header>

          <%# Featured media %>
          <% if (article.imageUrl) { %>
          <figure class="margin-bottom-6">
            <div class="article-feature-media width-full height-feature radius-card overflow-hidden surface-panel shadow-raised">
              <img class="media-image" src="<%= article.imageUrl %>" alt="<%= article.imageAlt %>">
            </div>
          </figure>
          <% } %>

          <%# Article body copy %>
          <div class="article-copy stack-5 text-article color-body text-relaxed text-normal">
            <% (article.paragraphs || []).forEach(function (p) { %>
            <p class="text-body text-2 color-body text-relaxed"><%= p %></p>
            <% }) %>
          </div>

          <% if ((locals.tags || []).length) { %>
          <div class="article-tags margin-top-6 pad-5 flex flex-wrap align-center gap-2">
            <span class="text-kicker text-1 color-muted text-uppercase">Filed under:</span>
            <% (locals.tags || []).forEach(function (tag) { %>
            <span class="pad-inline-3 pad-block-2 surface-panel radius-standard text-label text-1"><%= tag %></span>
            <% }) %>
          </div>
          <% } %>

          <%# Related stories %>
          <% if ((locals.related || []).length) { %>
          <section aria-labelledby="related-heading" class="related-dispatches margin-top-6 margin-bottom-6">
            <div class="flex align-center justify-between margin-bottom-5">
              <h2 class="text-headline text-5 color-primary" id="related-heading">More on this story</h2>
            </div>
            <div class="grid grid-single md-grid-triple gap-4">
              <% (locals.related || []).forEach(function (item) { %>
              <%- include('../../partials/public/article-card', { article: item }) %>
              <% }) %>
            </div>
          </section>
          <% } %>

          <%# Comments section and submission form %>
          <section aria-labelledby="comments-title" class="comment-thread surface-paper pad-6 radius-panel shadow-subtle">
            <div class="flex align-center justify-between pad-block-3 margin-bottom-5">
              <div class="flex align-center gap-2">
                <h2 class="text-headline text-5 color-primary" id="comments-title">Comments</h2>
                <span class="surface-raised color-primary text-kicker text-1 pad-block-2 radius-pill text-bold" id="comments-count"><%= commentsCount %></span>
              </div>
            </div>

            <form class="surface-muted pad-5 radius-card margin-bottom-6 stack-4" id="comment-form" data-article-id="<%= article.id %>">
              <div class="flex align-center justify-between">
                <span class="text-label text-2 color-primary">Add a comment</span>
                <span class="text-caption text-1 color-muted">No sign-up required</span>
              </div>
              <div>
                <label class="block text-label text-1 color-muted" for="guest-name">Name (optional)</label>
                <input class="width-full pad-inline-3 pad-block-2 surface-paper radius-standard text-body text-1 shadow-subtle control-input" id="guest-name" name="name" type="text">
              </div>
              <div>
                <div class="flex justify-between align-center">
                  <label class="text-label text-1 color-muted" for="comment-text">Your comment</label>
                  <span class="text-caption text-1 color-subtle" id="char-counter"></span>
                </div>
                <textarea class="width-full pad-3 surface-paper radius-standard text-body text-1 shadow-subtle control-no-resize control-input" id="comment-text" name="comment" maxlength="1000" required rows="3"></textarea>
              </div>
              <p class="state-hidden text-body text-1 color-muted" id="comment-status" role="status"></p>
              <div class="flex flex-column sm-row sm-align-center justify-between gap-4 pad-block-2">
                <p class="text-caption text-1 color-muted">You can post up to three comments per minute.</p>
                <button class="control-button color-inverse text-label text-1" type="submit">Post Comment</button>
              </div>
            </form>

            <div class="stack-4" id="comments-list">
              <% (locals.comments || []).forEach(function (comment) { %>
              <%- include('../../partials/comments/comment-item', { item: comment }) %>
              <% }) %>
            </div>
            <% if (!(locals.comments || []).length) { %>
            <p class="text-body text-1 color-muted text-center">No comments yet. Be the first to join the conversation.</p>
            <% } %>
          </section>
        </article>
      </div>

      <%# Weather sidebar %>
      <aside class="publication-sidebar lg-sidebar-span flex flex-column gap-5">
        <section class="surface-paper radius-panel pad-5 shadow-subtle" aria-label="Weather">
          <div id="weatherWidget"></div>
        </section>
      </aside>
    </div>
  </div>
</main>
<%# Public footer %>
<%- include('../../partials/public/footer') %>
<script src="/js/comments.js" defer></script>
<script src="/js/weather.js" defer></script>
</body>
</html>
