<!doctype html><html lang="en"><head><%- include('../../partials/shared/head', { pageTitle }) %></head>
<body class="public-page publication-page surface-page text-body text-2 color-body height-screen flex flex-column">
<%- include('../../partials/public/header-standard', { editionLabel, showBreaking, breakingText, searchQuery: '' }) %>
<main class="publication-main width-full surface-page flex-grow"><div class="publication-shell page-shell width-content pad-inline-5 pad-block-3"><div class="flex flex-column width-full">
<div class="breaking-card width-full surface-raised radius-card pad-3 margin-bottom-6 flex flex-column sm-row sm-align-center justify-between gap-3 shadow-subtle"><div class="flex align-center gap-3"><div class="flex align-center gap-2 pad-inline-3 pad-block-2 radius-standard surface-alert color-inverse text-label text-1 text-uppercase flex-no-shrink"><span class="avatar-small radius-pill surface-page state-loading"></span><span>Breaking</span></div><p class="text-body text-2 color-body truncate"><%= ticker %></p></div><div class="flex align-center gap-2 flex-no-shrink align-end text-caption text-1 color-muted"><span class="icon text-2">schedule</span><span>Updated 12m ago</span></div></div>
<div class="publication-grid grid grid-single lg-editorial-grid gap-6"><div class="publication-primary lg-content-span flex flex-column gap-6">
<article class="publication-lead surface-paper radius-panel overflow-hidden shadow-subtle motion-shadow flex flex-column"><div class="publication-lead-media relative width-full height-feature overflow-hidden surface-panel"><img class="width-full height-full media-cover interaction-zoom motion-transform" alt="Open-silicon microchip wafer in a semiconductor cleanroom." src="https://lh3.googleusercontent.com/aida-public/AB6AXuBFtqKSkCvl1tZHJEG3QQFP155UtWSSs6NGr2am-MRJzMPNykSlQTzzsb6diCpm-OiHVM5cnp06MPLj2COUFjpxJWh0322kGqpWE7IRA7Lze0c30Z_yQPPO9X63vIrrR0ykpIEG9w_d-cAf4W4y4Ua9NJksAW3qEjt00fGQ786sMePShXce8tv-SXAP7AJkGTEWueCmOMXr5v_fYh4nphdnRME6QyGeEQQFzaFlInWIqh2L_Booj326DA"><div class="absolute"><span class="pad-inline-3 pad-block-2 radius-standard surface-ink color-inverse text-label text-1 text-uppercase shadow-subtle">Technology</span></div></div><div class="pad-5 flex flex-column flex-grow"><div class="flex align-center gap-2 text-label text-1 color-muted margin-bottom-2"><span class="text-semibold color-body">By Dr. Jonathan Ben-Simon</span><span>•</span><span>2 hours ago</span><span>•</span><span class="flex align-center gap-1"><span class="icon text-2">timer</span>5 min read</span></div><h1 class="text-headline text-7 color-body margin-bottom-2 motion-colors text-tight">Breakthrough In Open Silicon: Next-Generation Computing Architecture Unveiled</h1><p class="text-headline text-deck color-muted margin-bottom-5 text-relaxed">Pioneering research consortium demonstrates an ultra-efficient instruction set capable of halving server farm energy consumption worldwide. The breakthrough sets an open standard poised to reshape public academic computation.</p><div class="margin-top-4 flex align-center justify-between"><a class="inline-flex align-center gap-2 text-label text-2 color-primary motion-colors" href="/articles/open-silicon"><span>Read Full Report</span><span class="icon text-4">arrow_forward</span></a><div class="flex align-center gap-2 color-muted"><button class="pad-2 radius-standard motion-colors" title="Bookmark article"><span class="icon text-4">bookmark_border</span></button><button class="pad-2 radius-standard motion-colors" title="Share story"><span class="icon text-4">share</span></button></div></div></div></article>
<section aria-labelledby="featured-heading"><div class="flex align-center justify-between margin-bottom-4"><h2 class="text-headline text-5 color-body" id="featured-heading">Featured Developments</h2><span class="text-label text-1 color-muted text-uppercase">Editor's Picks</span></div><div class="publication-featured-grid grid grid-single md-grid-triple gap-4"><% featured.forEach(function(article) { %><article class="publication-feature-card surface-paper radius-panel overflow-hidden shadow-subtle flex flex-column motion-shadow"><div class="publication-feature-media relative height-feature width-full surface-panel overflow-hidden"><img class="width-full height-full media-cover interaction-zoom motion-transform" src="<%= article.imageUrl %>" alt="<%= article.imageAlt %>"><span class="absolute pad-inline-3 pad-block-2 radius-standard surface-paper text-label text-1 color-body text-uppercase"><%= article.category %></span></div><div class="pad-4 flex flex-column flex-grow"><span class="text-caption text-1 color-muted margin-bottom-2"><%= article.dateLabel %></span><h3 class="text-headline text-4 color-body margin-bottom-2 motion-colors"><%= article.title %></h3><p class="text-body text-1 color-muted title-clamp"><%= article.summary %></p></div></article><% }) %></div></section>
<section class="publication-dispatches surface-paper radius-panel pad-5 shadow-subtle"><div class="flex align-center justify-between margin-bottom-4"><div class="flex align-center gap-2"><span class="icon color-primary">schedule</span><h2 class="text-headline text-5 color-body">Chronological Dispatch</h2></div><span class="text-caption text-1 color-muted">Real-Time Newsroom Wire</span></div><div class="stack-4"><% dispatches.forEach(function(item) { %><div class="flex flex-column sm-row sm-align-center justify-between gap-2 pad-3 radius-card motion-colors"><div class="flex align-center gap-3"><span class="text-caption text-1 text-semibold color-muted flex-no-shrink"><%= item.time %></span><span class="pad-inline-3 pad-block-2 radius-standard surface-raised text-label text-1 color-body text-uppercase flex-no-shrink"><%= item.category %></span><a class="text-headline text-4 color-body truncate" href="#"><%= item.title %></a></div><span class="text-caption text-1 color-subtle flex-no-shrink"><%= item.readTime %></span></div><% }) %></div></section></div>
<aside class="publication-sidebar span-sidebar flex flex-column gap-5"><section class="surface-paper radius-panel pad-5 shadow-subtle" aria-label="London weather"><div class="flex align-center justify-between margin-bottom-2"><div class="flex align-center gap-2"><span class="icon color-muted text-4">location_on</span><span class="text-label text-2 color-body text-semibold">London Bureau</span></div><span class="text-caption text-1 color-muted">Cached • 10m ago</span></div><div class="flex align-center justify-between"><div class="flex align-center gap-4"><div class="avatar-large radius-panel surface-muted flex align-center justify-center color-muted"><span class="icon text-6">cloud</span></div><div><div class="text-headline text-7 color-body text-bold text-tight">14°C</div><div class="text-body text-1 color-muted margin-top-2">Overcast &amp; Calm</div></div></div><div class="text-right text-caption text-1 color-muted stack-2"><div>Humidity: 78%</div><div>Wind: 9 km/h WNW</div><div class="color-primary text-medium">AQI: 24 (Good)</div></div></div></section>
<section class="surface-paper radius-panel pad-5 shadow-subtle flex flex-column"><div class="flex align-center justify-between margin-bottom-4"><div class="flex align-center gap-2"><span class="icon color-primary text-4">trending_up</span><h3 class="text-headline text-5 color-body">Most Read</h3></div><span class="text-label text-1 color-muted text-uppercase">24 Hours</span></div><ol class="stack-4"><% mostRead.forEach(function(item, index) { %><li class="flex align-start gap-4"><span class="text-headline text-6 color-muted state-muted text-bold text-tight avatar-small text-center"><%= index + 1 %></span><div class="flex-grow"><a class="text-body text-2 text-semibold color-body motion-colors title-clamp" href="#"><%= item.title %></a><div class="flex align-center gap-2 text-caption text-1 color-muted margin-top-2"><span><%= item.category %></span><span>•</span><span class="text-medium color-body"><%= item.views %></span></div></div></li><% }) %></ol></section>
<section class="surface-muted radius-panel pad-5 shadow-subtle"><div class="avatar-medium radius-card surface-ink color-inverse flex align-center justify-center margin-bottom-2"><span class="icon text-4">mark_email_unread</span></div><h3 class="text-headline text-5 color-body margin-bottom-2">The Morning Briefing</h3><p class="text-body text-1 color-muted margin-bottom-4 text-relaxed">Curated campus journalism, peer-reviewed science digests, and essential headlines delivered at 07:00 daily.</p><form class="flex flex-column gap-2" id="newsletter-form"><label class="state-hidden" for="newsletter-email">Email address</label><input class="width-full pad-inline-3 pad-block-2 radius-standard surface-paper text-body text-1 color-body control-input shadow-subtle" id="newsletter-email" name="email" placeholder="name@university.edu" required type="email"><button class="width-full pad-block-2 pad-inline-4 radius-standard surface-ink color-inverse text-label text-1 motion-colors text-center shadow-subtle" type="submit">Subscribe Free</button><p class="text-caption text-1 color-muted text-center margin-top-2">Zero advertisements. One-click unsubscribe anytime.</p></form><div class="state-hidden pad-3 surface-panel radius-standard text-center" id="newsletter-success"><span class="icon color-primary text-5">check_circle</span><p class="text-label text-1 color-body margin-top-2">You are subscribed!</p><p class="text-caption text-1 color-muted">Check your collegiate inbox for your confirmation.</p></div></section><section class="pad-4 radius-panel surface-paper shadow-subtle"><div class="flex align-center gap-2 color-primary margin-bottom-2"><span class="icon text-4">verified</span><span class="text-label text-1 text-semibold">Student Newsroom Charter</span></div><p class="text-caption text-1 color-muted text-relaxed">The Daily Web is independently managed by the Undergraduate Media Association. Dispatches adhere to rigorous academic fact-checking protocols.</p></section></aside></div></div></div></main>
<footer class="public-footer width-full surface-muted"><div class="width-content pad-inline-5 pad-block-3"><div class="grid grid-single md-grid-triple gap-6"><div><span class="text-headline text-4 color-primary">The Daily Web</span><p class="text-body text-1 color-muted">The independent digital news publication edited and maintained by collegiate journalists.</p></div><div><h4 class="text-label text-1 color-body text-uppercase margin-bottom-2">Sections</h4><ul class="stack-2 text-body text-1"><li class="color-muted">Technology</li><li class="color-muted">Business &amp; Campus Finance</li><li class="color-muted">Science &amp; Research</li><li class="color-muted">Editorial &amp; Opinion</li></ul></div><div><h4 class="text-label text-1 color-body text-uppercase margin-bottom-2">About Publication</h4><ul class="stack-2 text-body text-1"><li class="color-muted">Editorial Board</li><li class="color-muted">Ethics Policy</li><li class="color-muted">Archive Index</li><li class="color-muted">Academic Masthead</li></ul></div><div><h4 class="text-label text-1 color-body text-uppercase margin-bottom-2">Newsroom Contact</h4><p class="text-body text-1 color-muted margin-bottom-2">Newsroom Lab 304, Student Memorial Hall</p><p class="text-body text-1 color-muted">tips@dailyweb.edu</p></div></div><div class="margin-top-6 margin-top-5 text-center text-caption text-1 color-subtle">© 2024 The Daily Web Student Newsroom. Built with clean semantic modular templates.</div></div></footer></body></html>
