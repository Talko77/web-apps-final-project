<%# Public homepage: renders lead story, featured grid, dispatches, sidebar weather/most-read, and infinite scroll feed.
    Follows BEM component conventions (.home-page). %>
<!doctype html>
<html lang="en">
<head><%- include('../../partials/shared/head', { pageTitle }) %></head>
<body class="public-page home-page publication-page">
<%- include('../../partials/public/header-standard', { editionLabel, showBreaking, breakingText, searchQuery: '' }) %>
<main class="home-page__main">
  <div class="home-page__container page-shell">
    <div class="home-page__grid">
      <div class="home-page__primary">
        <%# Lead story %>
        <% const lead = (locals.featured || [])[0]; %>
        <% if (lead) { %>
        <article class="home-page__lead">
          <% if (lead.imageUrl) { %>
          <div class="home-page__lead-media">
            <img class="home-page__lead-image" src="<%= lead.imageUrl %>" alt="<%= lead.imageAlt %>">
            <span class="home-page__lead-category"><%= lead.category %></span>
          </div>
          <% } %>
          <div class="home-page__lead-body">
            <div class="home-page__lead-meta">
              <span class="home-page__lead-author">By <%= lead.author %></span>
              <span class="home-page__meta-separator">•</span>
              <span class="home-page__lead-date"><%= lead.dateLabel %></span>
              <span class="home-page__meta-separator">•</span>
              <span class="home-page__lead-read-time">
                <span class="icon home-page__lead-icon" aria-hidden="true">timer</span>
                <%= lead.readLabel %>
              </span>
              <span class="home-page__meta-separator">•</span>
              <span class="home-page__lead-views"><%= lead.views %> views</span>
            </div>
            <h1 class="home-page__lead-title"><%= lead.title %></h1>
            <p class="home-page__lead-summary"><%= lead.summary %></p>
            <div class="home-page__lead-action">
              <a class="home-page__lead-link" href="<%= lead.url %>">
                <span>Read the full story</span>
                <span class="icon home-page__lead-link-icon" aria-hidden="true">arrow_forward</span>
              </a>
            </div>
          </div>
        </article>
        <% } %>

        <%# Featured stories %>
        <% const secondary = (locals.featured || []).slice(1); %>
        <% if (secondary.length) { %>
        <section class="home-page__section" aria-labelledby="featured-heading">
          <div class="home-page__section-header">
            <h2 class="home-page__section-title" id="featured-heading">Featured Stories</h2>
            <span class="home-page__section-kicker">Editor's Picks</span>
          </div>
          <div class="home-page__articles-grid">
            <% secondary.forEach(function (item) { %>
            <%- include('../../partials/public/article-card', { article: item }) %>
            <% }) %>
          </div>
        </section>
        <% } %>

        <%# Latest dispatches %>
        <section class="home-page__dispatches" aria-labelledby="dispatches-heading">
          <div class="home-page__dispatches-header">
            <div class="home-page__dispatches-title-group">
              <span class="icon home-page__dispatches-icon" aria-hidden="true">schedule</span>
              <h2 class="home-page__dispatches-title" id="dispatches-heading">Latest Dispatches</h2>
            </div>
            <span class="home-page__dispatches-subtitle">Live updates from the newsroom</span>
          </div>
          <div class="home-page__dispatches-list">
            <% (locals.dispatches || []).forEach(function (item) { %>
            <div class="dispatch-item">
              <div class="dispatch-meta">
                <span class="dispatch-time"><%= item.time %></span>
                <span class="dispatch-category"><%= item.category %></span>
                <span class="dispatch-read-time"><%= item.readTime %></span>
              </div>
              <a class="dispatch-headline" href="<%= item.url %>"><%= item.title %></a>
            </div>
            <% }) %>
          </div>
        </section>

        <%# Infinite scroll feed with search and filters %>
        <section class="home-page__feed" aria-labelledby="feed-heading">
          <div class="home-page__feed-header">
            <h2 class="home-page__feed-title" id="feed-heading">All Articles</h2>
            <span class="home-page__feed-subtitle">More stories load as you scroll, with no page refresh</span>
          </div>
          <div class="home-page__feed-filters">
            <div class="home-page__filter-field">
              <label class="home-page__filter-label" for="feedSearch">Search the feed</label>
              <input class="home-page__filter-input" id="feedSearch" name="search" placeholder="Search by headline" type="search">
            </div>
            <div class="home-page__filter-field">
              <label class="home-page__filter-label" for="feedCategory">Category</label>
              <select class="home-page__filter-select" id="feedCategory" name="category">
                <option value="">All Categories</option>
                <% (locals.categories || []).forEach(function (category) { %>
                <option value="<%= category %>"><%= category %></option>
                <% }) %>
              </select>
            </div>
            <div class="home-page__filter-field">
              <label class="home-page__filter-label" for="feedSort">Sort by</label>
              <select class="home-page__filter-select" id="feedSort" name="sortBy">
                <option value="publishedAt">Newest First</option>
                <option value="popularity">Most Popular</option>
              </select>
            </div>
            <div class="home-page__filter-field">
              <label class="home-page__filter-label" for="feedSeen">Reading status</label>
              <select class="home-page__filter-select" id="feedSeen" name="seen">
                <option value="">All</option>
                <option value="unseen">Unread</option>
                <option value="seen">Read</option>
              </select>
            </div>
          </div>
          <div class="home-page__articles-grid" id="feedGrid" data-page="1" data-has-more="<%= hasMore %>">
            <% (locals.feed || []).forEach(function (item) { %>
            <%- include('../../partials/public/article-card', { article: item }) %>
            <% }) %>
          </div>
          <p class="home-page__feed-status state-hidden" id="feedStatus" role="status"></p>
          <div id="feedSentinel"></div>
        </section>
      </div>

      <%# Sidebar with weather and most-read articles %>
      <aside class="home-page__sidebar" aria-label="Sidebar">
        <section class="home-page__weather-card" aria-label="Weather">
          <div id="weatherWidget"></div>
        </section>

        <section class="home-page__most-read" aria-labelledby="most-read-heading">
          <div class="home-page__most-read-header">
            <div class="home-page__most-read-title-group">
              <span class="icon home-page__most-read-icon" aria-hidden="true">trending_up</span>
              <h2 class="home-page__most-read-title" id="most-read-heading">Most Read</h2>
            </div>
          </div>
          <ol class="home-page__most-read-list">
            <% (locals.mostRead || []).forEach(function (item, index) { %>
            <li class="home-page__most-read-item">
              <span class="home-page__most-read-rank"><%= index + 1 %></span>
              <div class="home-page__most-read-content">
                <a class="home-page__most-read-link" href="<%= item.url %>"><%= item.title %></a>
                <div class="home-page__most-read-meta">
                  <span class="home-page__most-read-category"><%= item.category %></span>
                  <span class="home-page__meta-separator">•</span>
                  <span class="home-page__most-read-views"><%= item.views %> views</span>
                </div>
              </div>
            </li>
            <% }) %>
          </ol>
        </section>
      </aside>
    </div>
  </div>
</main>
<%- include('../../partials/public/footer') %>
<script src="/js/feed.js" defer></script>
<script src="/js/weather.js" defer></script>
</body>
</html>
