<!doctype html><html lang="en"><head><%- include('../../partials/shared/head', { pageTitle }) %></head><body class="public-page search-page surface-page text-body color-body height-screen flex flex-column">
<%- include('../../partials/public/header-standard', { editionLabel, showBreaking, breakingText, searchQuery }) %>
<main class="search-page-main width-full surface-page flex-grow"><div class="width-content page-shell pad-inline-5 pad-5"><div class="flex flex-column width-full">
<section class="search-console surface-paper pad-5 pad-6 radius-panel shadow-subtle margin-bottom-6"><div class="width-reading page-shell flex flex-column gap-4"><div class="flex align-center justify-between"><span class="text-kicker text-1 text-uppercase color-muted flex align-center gap-1"><span class="radius-pill surface-alert"></span>Archive &amp; Dispatch Index</span><span class="text-caption text-1 color-subtle">Database: Fall 2024 Index</span></div><form class="flex flex-column sm-row gap-2 align-start" id="searchForm" action="/search" method="get"><div class="relative flex-grow"><span class="icon absolute color-muted text-5">search</span><label class="state-hidden" for="searchInput">Search query</label><input aria-label="Search query" class="width-full pad-block-3 surface-muted radius-standard text-body text-3 color-body motion-colors" id="searchInput" name="q" type="search" value="<%= searchQuery %>"></div><button class="inline-flex align-center justify-center gap-2 pad-inline-5 pad-block-3 surface-ink color-inverse text-label text-2 radius-standard shadow-subtle motion-transform" type="submit"><span class="icon text-4">manage_search</span><span>Search</span></button></form><div class="flex flex-wrap align-center justify-between gap-3 pad-block-2"><div class="flex align-center gap-2 text-body text-1 color-body"><span class="text-bold color-body">Found <%= resultCount %> results</span><span class="color-muted">for</span><span class="text-headline text-4 color-primary text-italic">“<%= searchQuery %>”</span><span class="text-1 text-caption color-subtle inline">(0.042 seconds)</span></div><div class="flex align-center gap-2"><span class="text-caption text-1 color-muted">Active tags:</span><% ['Technology','Semiconductors'].forEach(function(tag) { %><span class="inline-flex align-center gap-1 surface-panel pad-inline-3 pad-block-2 radius-standard text-kicker text-1 color-body"><%= tag %><button aria-label="Remove <%= tag %> filter" type="button">×</button></span><% }) %></div></div></div></section>
<div class="search-layout grid grid-single lg-editorial-grid gap-6 align-start"><aside class="search-filters lg-sidebar-span flex flex-column gap-5"><form class="surface-paper pad-5 radius-panel shadow-subtle stack-5 sticky"><div class="flex align-center justify-between pad-block-2"><h2 class="text-headline text-4 color-primary flex align-center gap-2"><span class="icon color-muted text-5">tune</span>Refine Query</h2><button class="text-label text-1 color-alert interaction-underline motion-all" id="resetBtn" type="reset">Reset All</button></div><fieldset class="stack-2"><legend class="block text-kicker text-1 text-uppercase color-muted">Publication Section</legend><div class="stack-2 surface-muted pad-2 radius-standard"><% categories.forEach(function(category) { %><label class="flex align-center justify-between pad-inline-3 pad-block-2 radius-standard control-pointer motion-colors<%= category.checked ? ' surface-paper shadow-subtle' : '' %>"><span class="flex align-center gap-2 text-body text-1 color-body"><input class="control-pointer" name="category" type="radio" value="<%= category.value %>" <%= category.checked ? 'checked' : '' %>><span><%= category.label %></span></span><span class="text-caption text-1 color-muted"><%= category.count %></span></label><% }) %></div></fieldset><fieldset class="stack-2"><legend class="block text-kicker text-1 text-uppercase color-muted">Date Published</legend><div class="grid grid-split gap-1"><% ['Past 24h','Past Week','Past Month','Any Time'].forEach(function(label) { %><button class="pad-block-2 pad-inline-3 text-center radius-standard <%= label === 'Past Month' ? 'surface-ink color-inverse' : 'surface-muted color-body' %> text-label text-1 motion-colors" type="button"><%= label %></button><% }) %></div></fieldset><div class="stack-2"><label class="block text-kicker text-1 text-uppercase color-muted" for="sortBySelect">Sort Hierarchy</label><select class="width-full surface-muted radius-standard pad-block-2 text-body text-1 color-body" id="sortBySelect" name="sort"><option>Most Relevant (Ranked)</option><option>Newest First (Chronological)</option><option>Most Viewed (Impact)</option></select></div><fieldset class="stack-2"><legend class="block text-kicker text-1 text-uppercase color-muted">Format Options</legend><label class="flex align-center gap-2 text-body text-1 color-body"><input checked type="checkbox">Campus Investigative Reports</label><label class="flex align-center gap-2 text-body text-1 color-body"><input checked type="checkbox">Peer-Reviewed Lab Briefs</label><label class="flex align-center gap-2 text-body text-1 color-body"><input type="checkbox">Multimedia &amp; Podcasts</label></fieldset><button class="width-full pad-block-2 surface-ink color-inverse text-label text-1 radius-standard text-center motion-colors" type="submit">Apply Filter Rules</button><p class="text-center text-caption text-1 color-muted">Synchronized with Collegiate News Wire</p><div class="surface-panel pad-3 radius-standard stack-2"><div class="flex align-center justify-between text-1 text-caption color-muted"><span>Query Sentiment</span><span class="text-bold color-body">Neutral / Analytical</span></div><p class="text-caption text-1 color-subtle">Keywords indexed against 4,820 campus archives.</p></div></form></aside>
<section class="search-results-list lg-content-span flex flex-column gap-4" aria-label="Search results"><div class="flex align-center justify-between surface-paper pad-inline-4 pad-block-2 radius-panel shadow-subtle"><div class="flex align-center gap-2"><span class="text-kicker text-1 text-uppercase color-muted">Display Mode:</span><button class="pad-inline-3 pad-block-2 radius-standard surface-panel text-label text-1 color-primary text-bold">Standard Detailed</button><button class="pad-inline-3 pad-block-2 radius-standard color-muted text-label text-1">Compact Headlines</button></div><div class="text-caption text-1 color-muted block">Showing <strong>1 – 4</strong> of <%= resultCount %> records</div></div>
<% results.forEach(function(result) { %><article class="search-result-card surface-paper pad-4 pad-5 radius-panel shadow-subtle motion-shadow flex flex-column sm-row gap-4"><div class="media-card width-full flex-no-shrink relative overflow-hidden radius-standard"><% if (result.imageUrl) { %><img class="width-full height-full media-image interaction-zoom motion-transform" src="<%= result.imageUrl %>" alt="<%= result.imageAlt %>"><% } else { %><div class="width-full height-full surface-panel flex flex-column align-center justify-center pad-3 text-center"><span class="icon color-muted text-7 margin-bottom-2"><%= result.icon %></span><span class="text-kicker text-1 text-uppercase color-muted">Editorial Column</span></div><% } %><% if (result.featured) { %><span class="absolute surface-ink color-inverse text-kicker text-1 pad-block-2 radius-standard">Featured Match</span><% } %></div><div class="flex flex-column justify-between flex-grow"><div><div class="flex align-center justify-between gap-2 margin-bottom-2"><div class="flex align-center gap-2"><span class="surface-panel color-body text-kicker text-1 pad-block-2 radius-standard text-uppercase text-bold"><%= result.category %></span><span class="color-subtle">•</span><time class="text-caption text-1 color-muted" datetime="<%= result.datetime %>"><%= result.dateLabel %></time></div><div class="flex align-center gap-1 text-caption text-1 color-muted"><span class="icon text-2">visibility</span><span><%= result.reads %></span></div></div><h3 class="text-headline text-5 color-primary margin-bottom-2 motion-colors"><a href="#"><%= result.title %></a></h3><p class="text-body text-2 color-muted title-clamp margin-bottom-2"><%= result.summary %></p></div><div class="flex align-center justify-between pad-block-2"><div class="flex align-center gap-2"><div class="avatar-small radius-pill surface-raised flex align-center justify-center text-kicker text-1 color-primary text-bold"><%= result.initials %></div><span class="text-body text-1 color-body text-medium"><%= result.author %></span><span class="text-caption text-1 color-muted">• <%= result.role %></span></div><a class="text-label text-1 color-primary interaction-underline flex align-center gap-1" href="#">Read dispatch<span class="icon text-2">arrow_forward</span></a></div></div></article><% }) %>
<nav aria-label="Search results pagination" class="margin-top-5 flex flex-column sm-row align-center justify-between gap-4 surface-paper pad-4 radius-panel shadow-subtle"><div class="text-caption text-1 color-muted">Page <strong class="color-body">1</strong> of <strong class="color-body">5</strong> pages</div><ul class="flex align-center gap-1"><li><button aria-label="Previous Page" disabled type="button">Previous</button></li><% [1,2,3,5].forEach(function(page) { %><li><button aria-current="<%= page === 1 ? 'page' : false %>" class="avatar-medium radius-standard <%= page === 1 ? 'surface-ink color-inverse' : 'surface-muted color-body' %> text-label text-1" type="button"><%= page %></button></li><% }) %><li><button aria-label="Next Page" type="button">Next</button></li></ul></nav><aside class="surface-muted pad-4 radius-panel flex align-start gap-3"><span class="icon color-muted text-5">lightbulb</span><div><h4 class="text-label text-2 color-body">Newsroom Archive Pro-Tip</h4><p class="text-body text-1 color-muted">Wrap phrases in quotes for verbatim matching or use section prefix operators like <code class="surface-panel pad-block-2 radius-standard color-primary">sec:opinion</code>.</p></div></aside></section></div></div></div></main>
<footer class="public-footer width-full surface-muted"><div class="width-content page-shell pad-inline-5 pad-6"><p class="text-headline text-4 color-primary">The Daily Web</p><p class="text-body text-1 color-muted">The independent digital news publication edited and maintained by collegiate journalists.</p><div class="margin-top-6 pad-5 text-center text-caption text-1 color-subtle">© 2024 The Daily Web Student Newsroom. Built with clean semantic modular templates.</div></div></footer></body></html>
