<%# Public search results view: renders search input console, category/sort sidebar filters, and article results list. %>
<!doctype html>
<html lang="en">
<head><%- include('../../partials/shared/head', { pageTitle }) %></head>
<body class="public-page search-page surface-page text-body color-body height-screen flex flex-column">
<%- include('../../partials/public/header-standard', { editionLabel, showBreaking, breakingText, searchQuery }) %>
<main class="search-page-main width-full surface-page flex-grow">
  <div class="width-content page-shell pad-inline-5 pad-5">
    <div class="flex flex-column width-full">
      <%# Search console bar %>
      <section class="search-console surface-paper pad-5 radius-panel shadow-subtle margin-bottom-6" aria-labelledby="search-heading">
        <div class="width-reading page-shell flex flex-column gap-4">
          <h1 class="text-headline text-5 color-body" id="search-heading">Search the Archive</h1>
          <form class="flex flex-column sm-row gap-2 align-start" id="searchForm" action="/search" method="get">
            <div class="relative flex-grow">
              <span class="icon absolute color-muted text-5">search</span>
              <label class="state-hidden" for="searchInput">Search terms</label>
              <input class="width-full pad-block-3 surface-muted radius-standard text-body text-3 color-body motion-colors control-input" id="searchInput" name="q" type="search" placeholder="Search by headline" value="<%= searchQuery %>">
            </div>
            <button class="inline-flex align-center justify-center gap-2 pad-inline-5 pad-block-3 surface-ink color-inverse text-label text-2 radius-standard shadow-subtle motion-transform" type="submit">
              <span class="icon text-4">manage_search</span><span>Search</span>
            </button>
          </form>
        </div>
      </section>

      <div class="search-layout grid grid-single lg-editorial-grid gap-6 align-start">
        <%# Category and sort filters sidebar %>
        <aside class="search-filters lg-sidebar-span flex flex-column gap-5">
          <div class="surface-paper pad-5 radius-panel shadow-subtle stack-5 sticky">
            <div class="flex align-center justify-between pad-block-2">
              <h2 class="text-headline text-4 color-primary flex align-center gap-2"><span class="icon color-muted text-5">tune</span>Filter by Category</h2>
            </div>
            <fieldset class="stack-2">
              <legend class="block text-kicker text-1 text-uppercase color-muted">Section</legend>
              <div class="stack-2 surface-muted pad-2 radius-standard">
                <% (locals.categories || []).forEach(function (category) { %>
                <label class="flex align-center justify-between pad-inline-3 pad-block-2 radius-standard control-pointer motion-colors<% if (category.checked) { %> surface-paper shadow-subtle<% } %>">
                  <span class="flex align-center gap-2 text-body text-1 color-body">
                    <input class="control-pointer" form="searchForm" name="category" type="radio" value="<%= category.value %>" <% if (category.checked) { %>checked<% } %>>
                    <span><%= category.label %></span>
                  </span>
                  <span class="text-caption text-1 color-muted"><%= category.count %></span>
                </label>
                <% }) %>
              </div>
            </fieldset>
            <fieldset class="stack-2">
              <legend class="block text-kicker text-1 text-uppercase color-muted">Sort by</legend>
              <div class="stack-2 surface-muted pad-2 radius-standard">
                <% [
                  { label: 'Newest First', value: 'publishedAt' },
                  { label: 'Most Popular', value: 'popularity' }
                ].forEach(function (option) { %>
                <label class="flex align-center justify-between pad-inline-3 pad-block-2 radius-standard control-pointer motion-colors<% if (sort === option.value) { %> surface-paper shadow-subtle<% } %>">
                  <span class="flex align-center gap-2 text-body text-1 color-body">
                    <input class="control-pointer" form="searchForm" name="sort" type="radio" value="<%= option.value %>" <% if (sort === option.value) { %>checked<% } %>>
                    <span><%= option.label %></span>
                  </span>
                </label>
                <% }) %>
              </div>
            </fieldset>
            <button class="width-full pad-block-2 surface-ink color-inverse text-label text-1 radius-standard text-center motion-colors" form="searchForm" type="submit">Apply Filters</button>
          </div>
        </aside>

        <%# Search results list %>
        <section class="search-results-list lg-content-span flex flex-column gap-4" aria-label="Search results">
          <% if (searchQuery) { %>
          <header class="stack-1 margin-bottom-2">
            <h2 class="text-headline text-5 color-body">Search results for: "<%= searchQuery %>"</h2>
            <p class="text-body text-1 color-muted"><%= resultCount %> articles found</p>
          </header>
          <% } %>
          <% (locals.results || []).forEach(function (item) { %>
          <%- include('../../partials/public/article-card', { article: item }) %>
          <% }) %>
          <% if (!(locals.results || []).length) { %>
          <div class="surface-paper pad-6 radius-panel shadow-subtle flex flex-column align-center gap-3 text-center">
            <span class="icon color-muted text-7">search_off</span>
            <h2 class="text-headline text-5 color-body">No articles found</h2>
            <p class="text-body text-1 color-muted">Try different search terms, or pick another category.</p>
          </div>
          <% } %>
        </section>
      </div>
    </div>
  </div>
</main>
<%# Public footer %>
<%- include('../../partials/public/footer') %>
</body>
</html>
