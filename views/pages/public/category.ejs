<%# Public category page: displays category headline/intro, article count, and published article grid.
    Follows BEM component conventions (.category-page). %>
<!doctype html>
<html lang="en">
  <head>
    <%- include('../../partials/shared/head', { pageTitle }) %>
  </head>
  <body class="category-page">
    <%- include('../../partials/public/header-standard', { editionLabel, showBreaking, breakingText, searchQuery: '' }) %>

    <main class="category-page__main">
      <div class="category-page__container page-shell">
        <header class="category-page__header">
          <nav class="category-page__breadcrumb" aria-label="Breadcrumb">
            <a class="category-page__breadcrumb-link" href="/">Home</a>
            <span class="category-page__breadcrumb-separator icon" aria-hidden="true">chevron_right</span>
            <span class="category-page__breadcrumb-current"><%= category %></span>
          </nav>

          <div class="category-page__heading-row">
            <div class="category-page__heading-group">
              <span class="category-page__kicker">Category Beat</span>
              <h1 class="category-page__title"><%= category %></h1>
              <p class="category-page__description">
                <%= typeof categoryDescription !== 'undefined' && categoryDescription ? categoryDescription : `Latest reporting, analysis, and dispatches in ${category}.` %>
              </p>
            </div>
            <div class="category-page__stats">
              <span class="icon category-page__stats-icon" aria-hidden="true">article</span>
              <span class="category-page__stats-text"><%= articleCount %> <%= articleCount === 1 ? 'article' : 'articles' %></span>
            </div>
          </div>
        </header>

        <% if ((locals.articles || []).length) { %>
        <section class="category-page__feed" aria-label="<%= category %> articles">
          <div class="category-page__grid">
            <% (locals.articles || []).forEach(function (item) { %>
            <%- include('../../partials/public/article-card', { article: item }) %>
            <% }) %>
          </div>
        </section>
        <% } else { %>
        <section class="category-page__empty" aria-label="No articles">
          <span class="icon category-page__empty-icon" aria-hidden="true">feed</span>
          <h2 class="category-page__empty-title">No articles found</h2>
          <p class="category-page__empty-description">There are currently no published articles in <%= category %>.</p>
          <div class="category-page__empty-action">
            <a class="button button--secondary" href="/">Return to Home</a>
          </div>
        </section>
        <% } %>
      </div>
    </main>

    <%- include('../../partials/public/footer') %>
  </body>
</html>
