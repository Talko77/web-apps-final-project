<!doctype html>
<html lang="he" dir="rtl">
  <head><%- include('../../partials/shared/head', { pageTitle }) %></head>
  <body
    class="editor-analytics-page surface-page text-body text-2 color-body height-screen flex flex-column"
  >
    <%- include('../../partials/newsroom/header', { newsroomRole }) %>
    <main class="site-header-offset width-full surface-page flex-grow">
      <div class="editor-page-content width-content pad-inline-5 pad-block-3">
        <div class="flex flex-column width-full gap-5">
          <section
            class="review-article-card surface-paper radius-panel pad-5 shadow-subtle flex flex-column gap-3"
          >
            <span class="text-label text-1 text-uppercase color-muted"
              >סטטיסטיקות השפעה</span
            >
            <h1 class="text-headline text-6 color-body">
              <%= page.article.title %>
            </h1>
            <div
              class="reporter-strip flex flex-wrap align-center gap-3 pad-block-2 surface-muted pad-inline-4 radius-card"
            >
              <span
                class="pad-inline-3 pad-block-2 radius-pill surface-ink color-inverse text-label text-1"
                ><%= page.article.category %></span
              >
              <span class="text-label text-2 color-body flex align-center gap-1">
                <span class="icon text-2 color-muted">badge</span>
                <%= page.article.reporter %>
              </span>
            </div>
          </section>
          <section
            class="analytics-card surface-paper radius-panel pad-5 shadow-subtle flex flex-column gap-4"
          >
            <div
              class="flex flex-column sm-row sm-align-center justify-between gap-3"
            >
              <div>
                <h2
                  class="text-headline text-4 color-body flex align-center gap-2"
                >
                  <span class="icon text-4 color-muted">trending_up</span>
                  צפיות לאורך זמן
                </h2>
                <p class="text-caption text-1 color-muted margin-top-2">
                  מספר הצפיות בכתבה בכל שעה, בטווח הזמן הנבחר.
                </p>
              </div>
              <div class="flex flex-wrap align-end gap-3">
                <div class="flex flex-column gap-2">
                  <label
                    class="text-label text-1 color-muted"
                    for="analyticsArticleSelect"
                    >כתבה</label
                  >
                  <select
                    class="surface-paper text-label text-1 color-body pad-inline-3 pad-block-2 radius-card control-pointer control-input shadow-subtle"
                    id="analyticsArticleSelect"
                  >
                    <% page.articleOptions.forEach(function (o) { %>
                    <option value="<%= o.id %>" <% if (o.selected) { %>selected<% } %>>
                      <%= o.title %>
                    </option>
                    <% }); %>
                  </select>
                </div>
                <div class="flex flex-column gap-2">
                  <label class="text-label text-1 color-muted" for="analyticsRange"
                    >טווח זמן</label
                  >
                  <select
                    class="surface-paper text-label text-1 color-body pad-inline-3 pad-block-2 radius-card control-pointer control-input shadow-subtle"
                    id="analyticsRange"
                  >
                    <option value="48">48 שעות אחרונות</option>
                    <option value="96" selected>4 ימים אחרונים</option>
                    <option value="168">שבוע אחרון</option>
                    <option value="504">3 שבועות אחרונים</option>
                  </select>
                </div>
              </div>
            </div>
            <div class="width-full surface-muted radius-card pad-4">
              <div class="analytics-plot relative width-full">
                <canvas
                  class="width-full height-full"
                  id="analyticsChart"
                  data-article-id="<%= page.articleId %>"
                  height="224"
                  role="img"
                  aria-label="גרף צפיות בכתבה לאורך זמן"
                ></canvas>
              </div>
            </div>
            <p
              class="state-hidden pad-3 radius-card text-body text-1 text-center"
              id="chartStatus"
              role="status"
              aria-live="polite"
            ></p>
            <div
              class="flex flex-column gap-2 text-label text-1 color-muted"
              aria-label="מפתח הגרף"
            >
              <span class="flex align-center gap-2">
                <span class="avatar-small radius-pill surface-info"></span>
                הקו הכהה מציג את מספר הצפיות בכתבה
              </span>
              <span class="flex align-center gap-2">
                <span class="avatar-small radius-pill surface-alert"></span>
                הקווים האנכיים המקווקווים באדום מסמנים את נקודות הזמן שבהן העורך
                אישר ופרסם עדכון לכתבה
              </span>
            </div>
          </section>
          <section
            class="grid grid-single sm-grid-split gap-3"
            aria-label="מדדי סיכום"
          >
            <% page.metrics.forEach(function (metric) { %>
            <%- include('../../partials/analytics/summary-metric', { item: metric }) %>
            <% }); %>
          </section>
        </div>
      </div>
    </main>
    <footer class="width-full surface-panel pad-block-3">
      <div
        class="width-content pad-inline-5 text-center text-caption text-1 color-muted"
      >
        The Daily Web · מערכת החדשות · שולחן העורך
      </div>
    </footer>
    <script src="/js/analyticsChart.js" defer></script>
  </body>
</html>
