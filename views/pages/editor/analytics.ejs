<%# Editor impact analytics view: renders article header, canvas traffic timeline with publication event markers, and summary metrics. %>
<!doctype html>
<html lang="en">
  <head><%- include('../../partials/shared/head', { pageTitle }) %></head>
  <body class="analytics-page editor-analytics-page">
    <%- include('../../partials/newsroom/header', { newsroomRole }) %>
    <main class="analytics-page__main">
      <div class="analytics-page__content">
        <%# Article summary header %>
        <section class="analytics-page__article-summary">
          <span class="analytics-page__eyebrow">Impact Analytics</span>
          <h1 class="analytics-page__title"><%= page.article.title %></h1>
          <div class="analytics-page__article-meta">
            <span class="analytics-page__category"><%= page.article.category %></span>
            <span class="analytics-page__reporter">
              <span class="icon analytics-page__meta-icon">badge</span>
              <%= page.article.reporter %>
            </span>
          </div>
        </section>

        <%# Chart controls, canvas, and legend %>
        <section class="analytics-card">
          <div class="analytics-card__header">
            <div>
              <h2 class="analytics-card__title">
                <span class="icon analytics-card__title-icon">trending_up</span>
                Views Over Time
              </h2>
              <p class="analytics-card__description">
                Hourly view counts for this article across the selected time range.
              </p>
            </div>
            <div class="analytics-card__filters">
              <div class="analytics-card__field">
                <label class="analytics-card__label" for="analyticsArticleSelect">Article</label>
                <select class="analytics-card__select control-input" id="analyticsArticleSelect">
                  <% page.articleOptions.forEach(function (o) { %>
                  <option value="<%= o.id %>" <% if (o.selected) { %>selected<% } %>>
                    <%= o.title %>
                  </option>
                  <% }); %>
                </select>
              </div>
              <div class="analytics-card__field">
                <label class="analytics-card__label" for="analyticsRange">Time range</label>
                <select class="analytics-card__select control-input" id="analyticsRange">
                  <option value="48">Last 48 hours</option>
                  <option value="96" selected>Last 4 days</option>
                  <option value="168">Last week</option>
                  <option value="504">Last 3 weeks</option>
                </select>
              </div>
              <%# Clears the hourly buckets and the cumulative counter for this article %>
              <div class="analytics-card__field">
                <button class="button button--secondary analytics-card__reset" id="resetViewData" type="button">
                  <span class="icon analytics-card__reset-icon">delete_sweep</span>
                  Reset view data
                </button>
              </div>
            </div>
          </div>
          <div class="analytics-card__chart-frame">
            <div class="analytics-plot">
              <canvas class="analytics-plot__canvas" id="analyticsChart" data-article-id="<%= page.articleId %>" height="224" role="img" aria-label="Chart of article views over time"></canvas>
            </div>
          </div>
          <p class="analytics-card__status state-hidden" id="chartStatus" role="status" aria-live="polite"></p>
          <div class="analytics-chart-legend" aria-label="Chart legend">
            <span class="analytics-chart-legend__item">
              <span class="analytics-chart-legend__marker analytics-chart-legend__marker--views"></span>
              The dark line shows the number of views for this article
            </span>
            <span class="analytics-chart-legend__item">
              <span class="analytics-chart-legend__marker analytics-chart-legend__marker--publication"></span>
              The dashed red vertical lines mark the moments an editor approved and published an update to this article
            </span>
          </div>
        </section>

        <%# Summary metric cards %>
        <section class="analytics-page__metrics" aria-label="Summary metrics">
          <% (page.metrics || []).forEach(function (metric) { %>
          <div class="analytics-summary-metric">
            <div class="analytics-summary-metric__content">
              <span class="analytics-summary-metric__label"><%= metric.label || 'Metric' %></span>
              <strong class="analytics-summary-metric__value"><%= metric.value || '—' %></strong>
              <span class="analytics-summary-metric__comparison"><%= metric.comparison || '' %></span>
            </div>
            <div class="analytics-summary-metric__icon">
              <span class="icon"><%= metric.icon || 'analytics' %></span>
            </div>
          </div>
          <% }); %>
        </section>
      </div>
    </main>
    <footer class="analytics-page__footer">
      <div class="analytics-page__footer-content">The Daily Web · Newsroom · Editor's Desk</div>
    </footer>
    <script src="/js/analyticsChart.js" defer></script>
  </body>
</html>
