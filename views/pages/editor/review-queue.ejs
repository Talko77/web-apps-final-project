<%# Editor review queue: displays submitted articles with client-side status/category filtering and review links. %>
<!doctype html>
<html lang="en">
  <head><%- include('../../partials/shared/head', { pageTitle }) %></head>
  <body class="review-queue editor-queue-page">
    <%- include('../../partials/newsroom/header', { newsroomRole }) %>
    <main class="review-queue__main">
      <div class="review-queue__content">
        <%# Queue intro and status summary %>
        <section class="review-queue__intro">
          <div class="review-queue__heading-row">
            <div>
              <span class="review-queue__eyebrow">Newsroom</span>
              <h1 class="review-queue__title">Review Queue</h1>
              <p class="review-queue__description">Stories submitted by reporters and waiting on an editor to review, approve and publish them.</p>
              <p class="review-queue__count-copy">Showing <span class="review-queue__count" id="queueCount"><%= page.articles.length %></span> of <span id="queueTotal"><%= page.totalCount %></span> articles.</p>
            </div>
            <div class="review-queue__status-summary">
              <% (page.statusFilters || []).forEach(function (filter) { %>
              <span class="review-queue__status-total">
                <span class="review-queue__status-count"><%= filter.count %></span>
                <%= filter.label %>
              </span>
              <% }); %>
            </div>
          </div>
        </section>

        <%# Search and category/status filters %>
        <section class="review-queue__filters">
          <div class="review-queue__filter-layout">
            <div class="review-queue__search-field">
              <label class="review-queue__field-label" for="queueSearch">Search by headline or reporter name</label>
              <input class="review-queue__search-input control-input" id="queueSearch" placeholder="For example: elections, or a reporter name" type="search" value="<%= page.searchQuery || '' %>" />
            </div>
            <div class="review-queue__filter-controls">
              <div class="review-queue__select-field">
                <label class="review-queue__field-label" for="categoryFilter">Category</label>
                <select class="review-queue__select control-input" id="categoryFilter">
                  <option value="" <% if (!page.activeCategory) { %>selected<% } %>>All Categories</option>
                  <% (page.categories || []).forEach(function (category) { %>
                  <option value="<%= category %>" <% if (category === page.activeCategory) { %>selected<% } %>><%= category %></option>
                  <% }); %>
                </select>
              </div>
              <div class="review-queue__select-field">
                <label class="review-queue__field-label" for="statusFilter">Status</label>
                <select class="review-queue__select control-input" id="statusFilter">
                  <% (page.statusFilters || []).forEach(function (filter) { %>
                  <option value="<%= filter.value %>" <% if (filter.value === page.activeStatus) { %>selected<% } %>><%= filter.label %> (<%= filter.count %>)</option>
                  <% }); %>
                </select>
              </div>
              <button class="review-queue__reset" id="resetFilters" type="button">
                <span class="icon review-queue__reset-icon">refresh</span>
                Reset Filters
              </button>
            </div>
          </div>
        </section>

        <%# Review queue table %>
        <div class="review-queue__table-card">
          <div class="review-queue__table-scroll">
            <table class="review-queue__table" id="queueTable">
              <thead>
                <tr class="review-queue__table-heading">
                  <th>Reporter</th>
                  <th>Headline</th>
                  <th>Category</th>
                  <th>Status</th>
                  <th>Version</th>
                  <th>Submitted</th>
                  <th class="review-queue__action-heading">Action</th>
                </tr>
              </thead>
              <tbody class="review-queue__table-body">
                <% (page.articles || []).forEach(function (a) { %>
                <tr class="review-queue__row" data-status="<%= a.statusCode %>" data-category="<%= a.categoryCode %>" data-title="<%= a.title %>" data-reporter="<%= a.reporterName %>">
                  <td class="review-queue__reporter-cell">
                    <div class="review-queue__reporter">
                      <div class="review-queue__avatar"><%= a.initials %></div>
                      <div>
                        <span class="review-queue__reporter-name"><%= a.reporterName %></span>
                        <span class="review-queue__reporter-beat"><%= a.beat %></span>
                      </div>
                    </div>
                  </td>
                  <td class="review-queue__headline-cell">
                    <% if (a.isUpdate) { %>
                    <span class="review-queue__update-label"><span class="icon review-queue__update-icon">update</span>Update to a published story - not a new article</span>
                    <% } %>
                    <a class="review-queue__headline" href="<%= a.url %>"><%= a.title %></a>
                    <p class="review-queue__summary"><%= a.summary %></p>
                    <span class="review-queue__read-time"><%= a.readLabel %></span>
                  </td>
                  <td class="review-queue__category-cell"><span class="review-queue__category"><%= a.category %></span></td>
                  <td class="review-queue__status-cell">
                    <span class="review-queue__status" data-status="<%= a.statusCode %>">
                      <span class="status-badge status-badge--pending">
                        <span class="status-badge__indicator state-loading"></span>
                        <%= a.statusLabel || 'Pending Review' %>
                      </span>
                    </span>
                  </td>
                  <td class="review-queue__version-cell"><span class="review-queue__version"><%= a.version %></span></td>
                  <td class="review-queue__submitted-cell">
                    <div class="review-queue__submitted-date"><time datetime="<%= a.submittedAt %>"><%= a.submittedLabel %></time></div>
                    <div class="review-queue__relative-date"><%= a.relativeDate %></div>
                  </td>
                  <td class="review-queue__action-cell"><a class="review-queue__review-link" href="<%= a.url %>">Review</a></td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <div class="review-queue__empty-container">
            <p class="review-queue__empty <%= page.articles.length > 0 ? 'state-hidden' : '' %>" id="queueEmptyState">No articles match the selected filters.</p>
          </div>
        </div>
      </div>
    </main>
    <footer class="review-queue__footer"><div class="review-queue__footer-content">The Daily Web · Newsroom · Editor's Desk</div></footer>
    <script src="/js/editorQueue.js" defer></script>
  </body>
</html>
