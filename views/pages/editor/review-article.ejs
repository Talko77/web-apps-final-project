<%# Editor review view: side-by-side comparison of live vs draft versions with editorial approve, return, and delete actions. %>
<!doctype html>
<html lang="en">
  <head><%- include('../../partials/shared/head', { pageTitle }) %></head>
  <body class="review-article editor-diff-page">
    <%- include('../../partials/newsroom/header', { newsroomRole }) %>
    <main class="review-article__main">
      <div class="review-article__content">
        <%# Review command summary bar %>
        <%# Article review header and update notice %>
        <header class="review-article-header">
          <div class="review-article-header__intro">
            <h1 class="review-article-header__title"><%= page.article.isUpdate ? 'Article Update Review' : 'Article Review' %></h1>
            <p class="review-article-header__subtitle">
              <%= page.article.isUpdate ? 'Compare the currently published version with the proposed update before approving.' : 'Review the submitted draft before publishing.' %>
            </p>
          </div>
          <% if (page.article.isUpdate) { %>
          <div class="review-article-header__notice" role="status">
            <span class="icon review-article-header__notice-icon" aria-hidden="true">update</span>
            <div class="review-article-header__notice-content">
              <span class="review-article-header__notice-title">This is an update to an already published article</span>
              <span class="review-article-header__notice-text">Readers continue to see the published version until this update is approved. Approving it will replace the content shown to the public.</span>
            </div>
          </div>
          <% } %>
        </header>

        <% if (page.article.editorNote) { %>
        <div class="review-command-card__editor-note">
          <span class="review-command-card__note-label">Latest Editor Note</span>
          <p class="review-command-card__note-text"><%= page.article.editorNote %></p>
        </div>
        <% } %>

        <%# Compact version comparison and info strip %>
        <section class="review-version-strip" aria-label="Version and article metadata">
          <div class="review-version-strip__flow">
            <%# Current live version %>
            <div class="review-version-strip__version review-version-strip__version--live">
              <div class="review-version-strip__version-main">
                <span class="review-version-strip__dot review-version-strip__dot--live" aria-hidden="true"></span>
                <span class="review-version-strip__version-tag"><%= page.article.liveVersion || 'v1.0' %></span>
                <span class="review-version-strip__version-status review-version-strip__version-status--live">
                  <%= page.article.published ? 'Currently live' : 'Not published' %>
                </span>
              </div>
              <div class="review-version-strip__version-sub">
                <%= page.article.publishedDateLabel ? 'Published on ' + page.article.publishedDateLabel : (page.article.published ? 'Published' : 'Not yet published') %>
              </div>
            </div>

            <%# Flow arrow %>
            <div class="review-version-strip__arrow" aria-hidden="true">
              <span class="icon review-version-strip__arrow-icon">arrow_forward</span>
            </div>

            <%# Proposed version %>
            <div class="review-version-strip__version review-version-strip__version--proposed">
              <div class="review-version-strip__version-main">
                <span class="review-version-strip__dot review-version-strip__dot--proposed" aria-hidden="true"></span>
                <span class="review-version-strip__version-tag"><%= page.article.proposedVersion || 'v1.0' %></span>
                <span class="review-version-strip__version-status review-version-strip__version-status--proposed">
                  <%= page.article.status === 'pending' ? 'Pending approval' : page.article.statusLabel %>
                </span>
              </div>
              <div class="review-version-strip__version-sub">
                Submitted <%= page.article.submittedLabelLower || page.article.submittedLabel.toLowerCase() %>
              </div>
            </div>
          </div>

          <div class="review-version-strip__divider" aria-hidden="true"></div>

          <%# Metadata: Desk, Category, Reporter %>
          <div class="review-version-strip__meta-group">
            <div class="review-version-strip__meta">
              <span class="icon review-version-strip__meta-icon" aria-hidden="true">folder</span>
              <div class="review-version-strip__meta-text">
                <span class="review-version-strip__meta-label">Desk</span>
                <span class="review-version-strip__meta-value"><%= page.article.desk %></span>
              </div>
            </div>

            <div class="review-version-strip__meta">
              <span class="icon review-version-strip__meta-icon" aria-hidden="true">local_offer</span>
              <div class="review-version-strip__meta-text">
                <span class="review-version-strip__meta-label">Category</span>
                <span class="review-version-strip__meta-value"><%= page.article.category || page.article.desk %></span>
              </div>
            </div>

            <div class="review-version-strip__meta">
              <span class="icon review-version-strip__meta-icon" aria-hidden="true">person</span>
              <div class="review-version-strip__meta-text">
                <span class="review-version-strip__meta-label">Reporter</span>
                <span class="review-version-strip__meta-value"><%= page.article.reporter %></span>
              </div>
            </div>
          </div>

          <div class="review-version-strip__divider" aria-hidden="true"></div>

          <%# Metadata: Submitted & Current views %>
          <div class="review-version-strip__meta-group">
            <div class="review-version-strip__meta">
              <span class="icon review-version-strip__meta-icon" aria-hidden="true">schedule</span>
              <div class="review-version-strip__meta-text">
                <span class="review-version-strip__meta-label">Submitted</span>
                <span class="review-version-strip__meta-value"><%= page.article.submittedLabel %></span>
              </div>
            </div>

            <div class="review-version-strip__meta">
              <span class="icon review-version-strip__meta-icon" aria-hidden="true">visibility</span>
              <div class="review-version-strip__meta-text">
                <span class="review-version-strip__meta-label">Current views</span>
                <span class="review-version-strip__meta-value"><%= page.article.views %></span>
              </div>
            </div>
          </div>
        </section>

        <%# Side-by-side live vs draft version comparison panes %>
        <div class="review-article__layout">
          <div class="review-article__comparison">
            <div class="review-article__panes">
              <%# Currently Live Pane %>
              <div class="comparison-pane comparison-pane--live">
                <div class="comparison-pane__header comparison-pane__header--live">
                  <div class="comparison-pane__header-left">
                    <span class="comparison-pane__dot comparison-pane__dot--live" aria-hidden="true"></span>
                    <span class="comparison-pane__header-title">Currently Live <%= page.article.liveVersion ? '(' + page.article.liveVersion + ')' : '' %></span>
                  </div>
                  <div class="comparison-pane__header-right">
                    <span class="comparison-pane__header-date">
                      <%= page.article.publishedDateLabel ? 'Published ' + page.article.publishedDateLabel : (page.article.published ? 'Published' : 'Not yet published') %>
                    </span>
                  </div>
                </div>
                <% if (!page.article.published) { %>
                <div class="comparison-pane__empty">
                  <p>This article has never been published, so there is no version visible to readers. Approving the version shown alongside will publish it for the first time.</p>
                </div>
                <div class="comparison-pane__footer">
                  <div class="comparison-pane__footer-views">
                    <span class="icon comparison-pane__footer-icon" aria-hidden="true">visibility</span>
                    <span>0 views</span>
                  </div>
                </div>
                <% } else { %>
                <% const pane = page.article.published; %>
                <article class="comparison-pane__article">
                  <div class="comparison-pane__meta-bar">
                    <span class="comparison-pane__category"><%= pane.category %></span>
                  </div>
                  <h1 class="comparison-pane__title"><%= pane.title %></h1>
                  <% if (pane.imageUrl) { %>
                  <div class="comparison-media">
                    <img class="comparison-media__image" alt="<%= pane.imageAlt %>" src="<%= pane.imageUrl %>" />
                  </div>
                  <% } %>
                  <% if (pane.summary) { %>
                  <p class="comparison-pane__summary"><%= pane.summary %></p>
                  <% } %>
                  <div class="comparison-pane__body">
                    <% (pane.paragraphs || []).forEach(p => { %>
                      <p><%= p %></p>
                    <% }) %>
                  </div>
                </article>
                <div class="comparison-pane__footer">
                  <div class="comparison-pane__footer-views">
                    <span class="icon comparison-pane__footer-icon" aria-hidden="true">visibility</span>
                    <span><%= page.article.views %> views</span>
                  </div>
                  <a class="comparison-pane__footer-link" href="/articles/<%= page.article.id %>" target="_blank" rel="noopener noreferrer">
                    <span>View on public site</span>
                    <span class="icon comparison-pane__link-icon" aria-hidden="true">open_in_new</span>
                  </a>
                </div>
                <% } %>
              </div>

              <%# Proposed Update / Draft Pane %>
              <div class="comparison-pane comparison-pane--draft">
                <div class="comparison-pane__header comparison-pane__header--proposed">
                  <div class="comparison-pane__header-left">
                    <span class="comparison-pane__dot comparison-pane__dot--proposed" aria-hidden="true"></span>
                    <span class="comparison-pane__header-title">
                      <%= page.article.isUpdate ? 'Proposed Update' : 'Proposed Version' %> (<%= page.article.proposedVersion || 'v1.0' %>)
                    </span>
                  </div>
                  <div class="comparison-pane__header-right">
                    <span class="comparison-pane__header-date">
                      Submitted <%= page.article.submittedLabelLower || page.article.submittedLabel.toLowerCase() %>
                    </span>
                  </div>
                </div>
                <% if (!page.article.draft) { %>
                <div class="comparison-pane__empty"><p>There is no version currently awaiting approval for this article.</p></div>
                <% } else { %>
                <% const pane = page.article.draft; %>
                <article class="comparison-pane__article">
                  <div class="comparison-pane__meta-bar">
                    <span class="comparison-pane__category"><%= pane.category %></span>
                  </div>
                  <h1 class="comparison-pane__title"><%= pane.title %></h1>
                  <% if (pane.imageUrl) { %>
                  <div class="comparison-media">
                    <img class="comparison-media__image" alt="<%= pane.imageAlt %>" src="<%= pane.imageUrl %>" />
                  </div>
                  <% } %>
                  <% if (pane.summary) { %>
                  <p class="comparison-pane__summary"><%= pane.summary %></p>
                  <% } %>
                  <div class="comparison-pane__body">
                    <% (pane.paragraphs || []).forEach(p => { %>
                      <p><%= p %></p>
                    <% }) %>
                  </div>
                </article>
                <div class="comparison-pane__footer">
                  <div class="comparison-pane__footer-views">
                    <span class="icon comparison-pane__footer-icon" aria-hidden="true">visibility</span>
                    <span><%= page.article.views %> views <% if (page.article.isUpdate) { %>(from current version)<% } %></span>
                  </div>
                  <a class="comparison-pane__footer-link" href="<%= page.article.published ? '/articles/' + page.article.id : '#' %>" target="_blank" rel="noopener noreferrer">
                    <span>Preview as it will appear</span>
                    <span class="icon comparison-pane__link-icon" aria-hidden="true">open_in_new</span>
                  </a>
                </div>
                <% } %>
              </div>
            </div>
          </div>

          <%# Editorial decision actions and metadata sidebar %>
          <aside class="review-article__sidebar">
            <div class="decision-card" id="reviewActions" data-article-id="<%= page.article.id %>">
              <div>
                <h2 class="decision-card__title">Editorial Decision</h2>
                <p class="decision-card__description">Compare the two versions before publishing or requesting changes.</p>
              </div>
              <div class="decision-card__field">
                <label class="decision-card__label" for="editorNotes">Note to the reporter</label>
                <p class="decision-card__hint">A note is required when requesting changes - explain what needs fixing. It is optional when approving and publishing.</p>
                <textarea class="decision-card__textarea control-input" id="editorNotes" placeholder="For example: the source in the third paragraph needs a second confirmation." rows="5"></textarea>
              </div>
              <% if (!page.article.canDecide) { %>
              <p class="decision-card__unavailable">Only an article that is pending review can be approved or sent back for changes. This article is currently "<%= page.article.statusLabel %>".</p>
              <% } %>
              <div class="review-article__actions">
                <button class="review-article__action review-article__action--approve" id="btn-approve" type="button" <% if (!page.article.canDecide) { %>disabled<% } %>>
                  <span class="icon review-article__action-icon">check_circle</span><span>Approve &amp; Publish</span>
                </button>
                <button class="review-article__action review-article__action--revise" id="btn-request-revisions" type="button" <% if (!page.article.canDecide) { %>disabled<% } %>>
                  <span class="icon review-article__action-icon">reply</span><span>Request Changes</span>
                </button>
                <button class="review-article__action review-article__action--delete" id="btn-delete" type="button">
                  <span class="icon review-article__action-icon">delete</span><span>Delete Article</span>
                </button>
              </div>
              <p class="decision-card__status state-hidden" id="statusAlert" role="status" aria-live="polite"></p>
            </div>
          </aside>
        </div>
      </div>
    </main>
    <script src="/js/editorReview.js" defer></script>
  </body>
</html>
