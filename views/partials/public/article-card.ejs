<%# כרטיס כתבה בפיד הציבורי.
    המקור היחיד למבנה הכרטיס: public/js/feed.js בונה DOM זהה
    עבור הכתבות שנטענות בגלילה האינסופית. שינוי כאן מחייב שינוי שם. %>
<% const card = typeof article !== 'undefined' && article ? article : {}; %>
<article class="article-card surface-paper radius-card overflow-hidden shadow-subtle" data-id="<%= card.id || '' %>" data-seen="<%= card.seen ? 'true' : 'false' %>">
  <a class="block" href="<%= card.url || '#' %>">
    <% if (card.imageUrl) { %>
    <div class="media-frame media-thumbnail surface-panel"><img class="width-full height-full media-cover" src="<%= card.imageUrl %>" alt="<%= card.imageAlt || '' %>" loading="lazy"></div>
    <% } %>
    <div class="pad-4">
      <div class="flex align-center justify-between gap-2">
        <span class="text-label text-1 text-uppercase color-primary"><%= card.category || 'חדשות' %></span>
        <span class="text-caption text-1 color-muted"><%= card.dateLabel || '' %></span>
      </div>
      <h2 class="text-headline text-4 color-body margin-top-2"><%= card.title || 'כתבה ללא כותרת' %></h2>
      <% if (card.summary) { %><p class="text-body text-1 color-muted margin-top-2"><%= card.summary %></p><% } %>
      <div class="flex align-center justify-between gap-2 margin-top-3">
        <span class="text-caption text-1 color-subtle"><%= card.author || '' %></span>
        <span class="text-caption text-1 color-muted"><%= card.views || '0' %> צפיות<% if (card.readLabel) { %> · <%= card.readLabel %><% } %></span>
      </div>
      <% if (card.seen) { %><span class="text-caption text-1 color-muted margin-top-2 block">נקראה</span><% } %>
    </div>
  </a>
</article>
