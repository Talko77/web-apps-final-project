<%# Article card used in the public feed.
    Single source of truth for the card markup: public/js/feed.js builds identical DOM
    for the articles loaded by infinite scroll. Any change here must be mirrored there. %>
<% const card = typeof article !== 'undefined' && article ? article : {}; %>
<article class="article-card" data-id="<%= card.id || '' %>" data-seen="<%= card.seen ? 'true' : 'false' %>">
  <a class="article-card__link" href="<%= card.url || '#' %>">
    <% if (card.imageUrl) { %>
    <div class="article-card__media"><img class="article-card__image" src="<%= card.imageUrl %>" alt="<%= card.imageAlt || '' %>" loading="lazy"></div>
    <% } %>
    <div class="article-card__body">
      <div class="article-card__meta">
        <span class="article-card__category"><%= card.category || 'News' %></span>
        <time class="article-card__date" datetime="<%= card.datetime || '' %>"><%= card.dateLabel || '' %></time>
      </div>
      <h2 class="article-card__title"><%= card.title || 'Untitled article' %></h2>
      <% if (card.summary) { %><p class="article-card__summary"><%= card.summary %></p><% } %>
      <div class="article-card__footer">
        <span class="article-card__author"><%= card.author || '' %></span>
        <span class="article-card__metrics"><%= card.views || '0' %> views<% if (card.readLabel) { %> · <%= card.readLabel %><% } %></span>
      </div>
      <% if (card.seen) { %><span class="article-card__read-state">Read</span><% } %>
    </div>
  </a>
</article>
