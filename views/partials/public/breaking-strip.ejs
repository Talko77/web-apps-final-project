<%# Breaking news ticker strip displayed below the public header when enabled.
    Uses BEM component styling (.breaking-strip) with page-shell centering. %>
<div class="breaking-strip site-breaking-bar">
  <div class="breaking-strip__inner page-shell">
    <span class="breaking-strip__badge">Breaking</span>
    <span class="breaking-strip__text"><%= typeof breakingText !== 'undefined' && breakingText ? breakingText : 'Rolling updates from The Daily Web newsroom' %></span>
  </div>
</div>
