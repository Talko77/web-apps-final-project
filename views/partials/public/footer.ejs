<%# Shared footer component for public publication pages.
    Renders the publication title, course project disclaimer, and demo data notice. %>
<footer class="public-footer width-full surface-muted">
  <div class="public-footer__content width-content page-shell pad-inline-5 pad-6">
    <p class="public-footer__title text-headline text-4 color-primary">The Daily Web</p>
    <p class="public-footer__description text-body text-1 color-muted">A sample news site, built as the final project for a web application development course.</p>
    <div class="public-footer__disclaimer margin-top-6 pad-5 text-center text-caption text-1 color-subtle">All content on this site is demo data for illustration purposes only.</div>
  </div>
</footer>
