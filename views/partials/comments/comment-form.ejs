<form class="comment-form" id="comment-form">
  <div class="comment-form__heading">
    <span class="comment-form__title">Leave a Public Thought</span>
    <span class="comment-form__hint">No registration required</span>
  </div>
  <div class="comment-form__identity-fields">
    <div class="form-field">
      <label class="form-field__label" for="guest-name">Your Name or Alias</label>
      <input
        class="form-field__control"
        id="guest-name"
        name="name"
        placeholder="e.g. Marcella / VLSI Fellow"
        required
        type="text"
      />
    </div>
    <div class="form-field">
      <label class="form-field__label" for="guest-affil">Affiliation / Institution (Optional)</label>
      <input
        class="form-field__control"
        id="guest-affil"
        name="affiliation"
        placeholder="e.g. Stanford Dept of EE"
        type="text"
      />
    </div>
  </div>
  <div class="form-field">
    <div class="form-field__header">
      <label class="form-field__label" for="comment-text">Comment</label>
      <span class="form-field__counter" id="char-counter">380 characters remaining</span>
    </div>
    <textarea
      class="form-field__control form-field__control--textarea"
      id="comment-text"
      name="comment"
      maxlength="380"
      placeholder="Share your technical observations, questions, or perspectives on this dispatch..."
      required
      rows="3"
    ></textarea>
  </div>
  <div class="comment-form__footer">
    <p class="comment-form__notice">
      Guests may submit comments without registration. Submissions adhere to our
      newsroom code of conduct.
    </p>
    <button class="button button--primary" type="submit">Post Comment</button>
  </div>
</form>
