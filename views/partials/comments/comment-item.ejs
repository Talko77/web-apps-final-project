<% const comment = typeof item !== 'undefined' && item ? item : {}; %><article class="comment-item rule-bottom pad-block-4"><div class="flex align-start gap-3"><div class="avatar-small radius-pill surface-info color-info flex align-center justify-center text-label text-1"><%= comment.initials || 'אח' %></div><div class="flex-grow"><div class="flex align-center justify-between gap-3"><strong class="text-label text-1 color-body"><%= comment.author || 'אורח' %></strong><time class="text-caption text-1 color-muted" datetime="<%= comment.datetime || '' %>"><%= comment.dateLabel || 'עכשיו' %></time></div><p class="text-body text-2 color-body margin-top-2"><%= comment.text || '' %></p></div></div></article>
