<% const queueArticle = typeof item !== 'undefined' && item ? item : {}; %><article class="queue-row surface-paper rule-bottom pad-4 flex flex-column md-row align-start md-align-center justify-between gap-3" data-article-id="<%= queueArticle.id || '' %>"><div class="flex flex-column gap-1"><span class="text-label text-1 text-uppercase color-primary"><%= queueArticle.category || 'News' %></span><h2 class="text-headline text-4 color-body"><%= queueArticle.title || 'Article headline' %></h2><p class="text-caption text-1 color-muted"><%= queueArticle.reporterName || 'Reporter' %> — <%= queueArticle.submittedLabel || 'Submitted today' %></p></div><div class="flex align-center gap-3"><%- include('./editor-status-badge', { statusLabel: queueArticle.statusLabel || 'Pending Review' }) %><a class="control-button control-button-secondary text-label text-1" href="<%= queueArticle.url || '#' %>">Review</a></div></article>
