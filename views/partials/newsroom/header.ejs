<%# Newsroom header: shared top navigation bar for reporter and editor workspace pages. %>
<% const role = typeof newsroomRole !== 'undefined' && newsroomRole ? newsroomRole : 'Staff'; %>
<% const isEditor = typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'Editor'; %>
<header class="site-header fixed width-full surface-paper shadow-subtle">
  <div class="site-header-inner width-content pad-inline-5 flex align-center justify-between gap-4">
    <div class="flex align-center gap-4">
      <%- include('../shared/site-logo', { logoHref: isEditor ? '/editor/reviews' : '/reporter/articles', publicationName: 'The Daily Web', editionLabel: null }) %>
      <span class="pad-inline-3 pad-block-2 radius-standard surface-info color-info text-label text-1 text-uppercase text-semibold"><%= role %></span>
    </div>
    <nav class="site-primary-nav flex align-center gap-5" aria-label="Newsroom navigation">
      <% if (isEditor) { %>
        <a class="text-label text-2 color-muted motion-colors" href="/editor/reviews">Review Queue</a>
        <a class="text-label text-2 color-muted motion-colors" href="/editor/analytics">Analytics</a>
      <% } else { %>
        <a class="text-label text-2 color-muted motion-colors" href="/reporter/articles">My Articles</a>
        <a class="text-label text-2 color-muted motion-colors" href="/reporter/articles/new/edit">New Article</a>
      <% } %>
    </nav>
    <div class="flex align-center gap-4">
      <% if (typeof currentUser !== 'undefined' && currentUser) { %><span class="text-label text-1 color-body"><%= currentUser.displayName %></span><% } %>
      <a class="text-label text-1 color-muted flex align-center gap-1 motion-colors" href="/"><span class="icon text-2">open_in_new</span>View Public Site</a>
      <button class="text-label text-1 color-muted motion-colors" id="logoutBtn" type="button">Sign Out</button>
    </div>
  </div>
</header>
