<form class="review-feedback-form" method="post">
  <div class="form-field">
    <label class="form-field__label form-field__label--caps" for="editorFeedback">Editorial feedback</label>
    <textarea class="form-field__control form-field__control--textarea" id="editorFeedback" name="feedback" rows="5" placeholder="Explain the revisions needed"></textarea>
  </div>
  <button class="button button--secondary review-feedback-form__submit" type="submit">Send Feedback</button>
</form>
