<% const actionVariant = typeof variant !== 'undefined' ? variant : 'toolbar'; %>
<% if (actionVariant === 'stacked') { %>
  <div class="flex flex-column gap-2 margin-top-2">
    <button class="editor-action editor-action-approve width-full pad-block-3 pad-inline-4 surface-ink color-inverse radius-card text-label text-2 text-semibold flex align-center justify-center gap-2 motion-all shadow-subtle" id="btn-approve" type="button"><span class="icon text-4">check_circle</span><span>✓ Approve &amp; Publish Live</span></button>
    <button class="editor-action editor-action-revise width-full pad-block-3 pad-inline-4 surface-info color-info radius-card text-label text-2 text-semibold flex align-center justify-center gap-2 motion-all" id="btn-request-revisions" type="button"><span class="icon text-4">reply</span><span>↩ Request Changes</span></button>
    <button class="editor-action editor-action-reject width-full pad-block-3 pad-inline-4 surface-alert color-alert radius-card text-label text-2 text-semibold flex align-center justify-center gap-2 motion-all margin-top-2" id="btn-reject" type="button"><span class="icon text-4">cancel</span><span>✕ Reject Draft</span></button>
  </div>
  <div class="state-hidden pad-3 radius-card text-body text-1 text-center" id="statusAlert" role="status" aria-live="polite"></div>
<% } else { %>
  <div class="flex flex-wrap align-center gap-2">
    <button class="inline-flex align-center gap-1 pad-inline-3 pad-block-2 radius-standard surface-panel color-body motion-colors text-label text-1 text-medium" id="btn-preview" type="button"><span class="icon text-4">devices</span><span>Preview Responsive</span></button>
    <button class="inline-flex align-center gap-1 pad-inline-3 pad-block-2 radius-standard surface-muted color-muted motion-colors text-label text-1" id="btn-unpublish" type="button"><span class="icon text-4">unpublished</span><span>Unpublish Live v1.0</span></button>
    <button class="inline-flex align-center gap-1 pad-inline-3 pad-block-2 radius-standard surface-raised color-muted motion-all text-label text-1" id="btn-reject" type="button"><span class="icon text-4">close</span><span>Reject Draft</span></button>
    <button class="inline-flex align-center gap-1 pad-inline-3 pad-block-2 radius-standard surface-info color-inverse motion-colors text-label text-1 shadow-subtle" id="btn-request-revisions" type="button"><span class="icon text-4">assignment_return</span><span>Request Revisions</span></button>
    <button class="inline-flex align-center gap-1 pad-inline-4 pad-block-2 radius-standard surface-ink color-inverse motion-all text-label text-1 shadow-subtle" id="btn-approve" type="button"><span class="icon text-4">verified</span><span>Approve &amp; Publish Live</span></button>
  </div>
<% } %>
