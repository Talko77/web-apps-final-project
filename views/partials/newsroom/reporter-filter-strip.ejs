<% const filterStatuses = typeof statuses !== 'undefined' && statuses ? statuses : ['All', 'Draft', 'Pending Review', 'Published', 'Returned']; const selectedStatus = typeof activeStatus !== 'undefined' && activeStatus ? activeStatus : 'All'; %><div class="article-filter-strip surface-paper pad-4 radius-card shadow-subtle margin-bottom-4 flex flex-column md-row align-center justify-between gap-4"><div class="flex flex-wrap align-center gap-2" id="statusFilterPills"><% filterStatuses.forEach(function(status) { %><button class="filter-btn <%= status === selectedStatus ? 'active surface-ink color-inverse' : 'surface-panel color-muted' %> pad-inline-3 pad-block-2 radius-standard text-1 text-label motion-colors" aria-pressed="<%= status === selectedStatus %>" data-status="<%= status %>" type="button"><%= status %></button><% }) %></div></div>
