# Copy this file to .env and fill in the values. Never commit .env.

# Database connection
MONGO_URI=mongodb://127.0.0.1:27017/daily_web

# Key used to sign the session cookie. Replace with a long random string.
SESSION_SECRET=replace_with_a_long_random_string

# Server port
PORT=3000

# development or production
NODE_ENV=development

# Set to true only when the app runs behind a reverse proxy (needed for secure cookies there).
# Left unset, the client IP used by the comment limit cannot be faked with X-Forwarded-For.
TRUST_PROXY=

# Free key from https://openweathermap.org/api (Free tier, no payment details).
# If the key is missing, the weather widget says the data is unavailable instead of failing.
WEATHER_API_KEY=
WEATHER_CITY=Tel Aviv
