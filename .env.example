# העתיקו קובץ זה ל-.env ומלאו את הערכים. אין להעלות את .env ל-Git.

# חיבור למסד הנתונים
MONGO_URI=mongodb://127.0.0.1:27017/daily_web

# מפתח לחתימת ה-session. יש להחליף במפתח אקראי ארוך
SESSION_SECRET=replace_with_a_long_random_string

# פורט השרת
PORT=3000

# development או production
NODE_ENV=development

# מפתח חינמי מ-https://openweathermap.org/api (מסלול Free, ללא פרטי אשראי)
# אם המפתח חסר, ווידג'ט מזג האוויר יציג נתוני ברירת מחדל ולא ייכשל
WEATHER_API_KEY=
WEATHER_CITY=Tel Aviv
